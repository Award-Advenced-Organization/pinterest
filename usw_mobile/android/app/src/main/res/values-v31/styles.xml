<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 et plus : l ecran de demarrage du systeme montre l icone
         (le logo) sur le fond de USW, puis l ouverture de USW prend le relais. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/fond</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/fond</item>
    </style>
</resources>
