  usecase "UC26 Rechercher\nlieux, contenus, créateurs" as UC26
  usecase "UC21 Filtrer\npays, ville, type de lieu,\nproximité" as UC21
  usecase "UC22 Consulter un contenu\nlieu, appareil, date, badge" as UC22
  usecase "UC23 Explorer la carte\ndes reels" as UC23
  usecase "UC24 Télécharger\nl'original" as UC24
  usecase "UC30 Lancer l'itinéraire\n« Y aller »" as UC30
