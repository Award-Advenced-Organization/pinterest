' USW, United State of World : diagrammes de cas d'utilisation
' Source : Cahier_De_Charges_Groupe4.pdf, version 2 (sections 3 et 7)
' Les numeros UCxx renvoient a analyse/ANALYSE.md
' Un diagramme d'ensemble, puis un diagramme par module.

' =================================================================== 1
@startuml cas-utilisation-1-ensemble
!include style.iuml
title Vue d'ensemble : acteurs et modules
left to right direction

actor "Visiteur" as Visiteur
actor "Membre" as Membre
actor "Créateur" as Createur
actor "Modérateur" as Moderateur
actor "Application de\ncartographie" as Carto <<système>>
actor "GPS du\ntéléphone" as GPS <<système>>
actor "Messagerie\n(WhatsApp)" as Messagerie <<système>>

Visiteur <|-- Membre
Membre <|-- Createur
Membre <|-- Moderateur

rectangle "USW · United State of World" {
  usecase "Compte\nUC01 à UC03" as Compte
  usecase "Exploration\nUC20 à UC26" as Exploration
  usecase "Itinéraire\nUC30, UC31" as Itineraire
  usecase "Dépôt et reels\nUC10 à UC19, UC27" as Depot
  usecase "Communauté\nUC40 à UC48" as Communaute
  usecase "Modération\nUC50 à UC54" as Moderation
}

Visiteur --> Compte
Visiteur --> Exploration
Visiteur --> Itineraire
Membre --> Depot
Membre --> Communaute
Membre --> Moderation
Createur --> Communaute
Moderateur --> Moderation

Itineraire --> Carto
Itineraire --> GPS
Exploration --> GPS
Communaute --> Messagerie
@enduml

' =================================================================== 2
@startuml cas-utilisation-2-depot
!include style.iuml
title Dépôt : publier une photo ou un reel

actor "Membre" as Membre

rectangle "Dépôt et reels" {
  usecase "UC11 Prendre une photo\navec l'appareil du téléphone" as UC11
  usecase "UC12 Importer depuis\nla galerie" as UC12
  usecase "UC18 Tourner un reel\npar séquences" as UC18
  usecase "UC19 Monter le reel\ncouper, ordonner,\ntexte, son" as UC19
  usecase "UC10 Publier un contenu\nphoto ou reel" as UC10
  usecase "UC27 Compléter les informations\nmanquantes : téléphone,\ndate, lieu" as UC27
  usecase "UC13 Extraire les métadonnées\net pré-remplir" as UC13
  usecase "UC14 Vérifier l'authenticité\nsignes d'IA, cohérence,\nniveau du badge" as UC14
  usecase "UC15 Envoyer le média\npar morceaux, avec reprise" as UC15
  usecase "UC16 Préparer les\nversions WebP" as UC16
  usecase "UC17 Suivre ses envois\npause, reprise, annulation" as UC17
}

Membre --> UC10
Membre --> UC11
Membre --> UC12
Membre --> UC18
Membre --> UC17

UC18 <.. UC19 : <<extend>>
UC12 <.. UC19 : <<extend>>\nvidéo importée
UC11 ..> UC10 : <<extend>>
UC12 ..> UC10 : <<extend>>
UC18 ..> UC10 : <<extend>>
UC27 .> UC10 : <<extend>>\nsi une information\nmanque au fichier
UC10 ..> UC13 : <<include>>
UC10 ..> UC14 : <<include>>
UC10 ..> UC15 : <<include>>
UC15 ..> UC16 : <<include>>
@enduml

