 stroke-width=\"1.5\"/><path d=\"M5.9 10.2h12.2M9.2 5.2v2.8M14.8 5.2v2.8\" stroke=\"#fff\" stroke-width=\"1.5\"/><circle cx=\"9.4\" cy=\"13.4\" r=\"0.9\" fill=\"#fff\" stroke=\"none\"/><circle cx=\"12\" cy=\"13.4\" r=\"0.9\" fill=\"#fff\" stroke=\"none\"/><circle cx=\"14.6\" cy=\"13.4\" r=\"0.9\" fill=\"#fff\" stroke=\"none\"/><circle cx=\"9.4\" cy=\"15.9\" r=\"0.9\" fill=\"#fff\" stroke=\"none\"/><circle cx=\"12\" cy=\"15.9\" r=\"0.9\" fill=\"#fff\" stroke=\"none\"/></symbol>\r\n  <symbol id=\"i-boussole\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"8.5\"/><path d=\"M12 5.9 14.3 12H9.7z\" fill=\"#EA4335\" stroke=\"none\"/><path d=\"M12 18.1 9.7 12h4.6z\" fill=\"#9AA0A6\" stroke=\"none\"/></symbol>\r\n  <symbol id=\"i-logo\" viewBox=\"0 0 100 101\"><path d=\"M16.2368 18.191C25.5008 7.58981 39.2907 1.10228 54.4562 1.65653C68.5963 2.1733 81.0968 8.70816 89.5844 18.7076C85.6479 15.5041 80.6746 13.5081 75.2119 13.3084C65.9849 12.9712 57.7764 17.8473 53.4243 25.2988C51.4789 28.6298 50.304 32.4754 50.1532 36.6C49.8902 43.7969 46.0638 50.023 40.4329 53.6433C40.0375 53.865 39.6488 54.0977 39.2675 54.3409C36.0073 56.153 32.2264 57.1263 28.2269 56.9802C16.6419 56.5568 7.57232 46.8997 7.8381 35.346C7.93753 33.3271 8.28244 31.3768 8.84285 29.5232C10.3087 26.389 12.0996 23.4415 14.1706 20.7224C14.8313 19.8549 15.5205 19.0107 16.2368 18.191Z\" fill=\"#0A0A0A\"/><path d=\"M62.2429 55.2077C63.9318 56.0182 65.5107 57.0215 66.9511 58.1889C68.7004 59.6067 70.2453 61.2667 71.535 63.1179C74.2291 66.9851 75.8089 71.6867 75.8089 76.7572C75.8089 89.7119 65.4971 100.258 52.6338 100.636C78.8856 100.095 100 78.645 100 52.2636C100 45.8646 98.7579 39.7558 96.5014 34.1651C96.8128 35.7144 96.9762 37.3173 96.9762 38.9584C96.9762 37.159 96.7517 35.4121 96.3292 33.7442C94.9547 30.4293 93.2222 27.3003 91.18 24.4054C87.322 20.332 81.8622 17.791 75.8089 17.791C64.1185 17.791 54.6416 27.268 54.6416 38.9584C54.6416 45.4868 57.597 51.3248 62.2429 55.2077Z\" fill=\"#0A0A0A\"/><path d=\"M43.614 97.8961C45.1374 98.2867 46.7284 98.5125 48.3676 98.553C21.6548 97.8928 0.535039 75.7026 1.19525 48.9898C1.35734 42.4318 2.81702 36.2109 5.3227 30.5665C4.85904 32.2236 4.59144 33.9645 4.54698 35.7634C4.54553 35.822 4.54431 35.8805 4.54338 35.9389L4.54175 36.0557C4.53785 36.1596 4.53461 36.2637 4.53204 36.368C4.20193 49.7244 14.7618 60.8195 28.1182 61.1496C28.6063 61.1617 29.0914 61.1592 29.5731 61.1425C32.4127 61.0445 35.1329 60.4547 37.6487 59.454C38.9268 58.9457 40.1522 58.3313 41.3136 57.6214C43.8233 56.6585 46.5594 56.1607 49.4136 56.2312C61.1004 56.5201 70.3403 66.2283 70.0515 77.9151C69.7638 89.5531 60.1355 98.7645 48.5142 98.5562C46.8296 98.5037 45.1905 98.2778 43.614 97.8961Z\" fill=\"#0A0A0A\"/></symbol>\r\n  <symbol id=\"i-logo-sombre\" viewBox=\"0 0 100 101\"><path d=\"M16.2368 18.191C25.5008 7.58981 39.2907 1.10228 54.4562 1.65653C68.5963 2.1733 81.0968 8.70816 89.5844 18.7076C85.6479 15.5041 80.6746 13.5081 75.2119 13.3084C65.9849 12.9712 57.7764 17.8473 53.4243 25.2988C51.4789 28.6298 50.304 32.4754 50.1532 36.6C49.8902 43.7969 46.0638 50.023 40.4329 53.6433C40.0375 53.865 39.6488 54.0977 39.2675 54.3409C36.0073 56.153 32.2264 57.1263 28.2269 56.9802C16.6419 56.5568 7.57232 46.8997 7.8381 35.346C7.93753 33.3271 8.28244 31.3768 8.84285 29.5232C10.3087 26.389 12.0996 23.4415 14.1706 20.7224C14.8313 19.8549 15.5205 19.0107 16.2368 18.191Z\" fill=\"white\"/><path d=\"M62.2429 55.2077C63.9318 56.0182 65.5107 57.0215 66.9511 58.1889C68.7004 59.6067 70.2453 61.2667 71.535 63.1179C74.2291 66.9851 75.8089 71.6867 75.8089 76.7572C75.8089 89.7119 65.4971 100.258 52.6338 100.636C78.8856 100.095 100 78.645 100 52.2636C100 45.8646 98.7579 39.7558 96.5014 34.1651C96.8128 35.7144 96.9762 37.3173 96.9762 38.9584C96.9762 37.159 96.7517 35.4121 96.3292 33.7442C94.9547 30.4293 93.2222 27.3003 91.18 24.4054C87.322 20.332 81.8622 17.791 75.8089 17.791C64.1185 17.791 54.6416 27.268 54.6416 38.9584C54.6416 45.4868 57.597 51.3248 62.2429 55.2077Z\" fill=\"#5D7CFB\"/><path d=\"M43.614 97.8961C45.1374 98.2867 46.7284 98.5125 48.3676 98.553C21.6548 97.8928 0.535039 75.7026 1.19525 48.9898C1.35734 42.4318 2.81702 36.2109 5.3227 30.5665C4.85904 32.2236 4.59144 33.9645 4.54698 35.7634C4.54553 35.822 4.54431 35.8805 4.54338 35.9389L4.54175 36.0557C4.53785 36.1596 4.53461 36.2637 4.53204 36.368C4.20193 49.7244 14.7618 60.8195 28.1182 61.1496C28.6063 61.1617 29.0914 61.1592 29.5731 61.1425C32.4127 61.0445 35.1329 60.4547 37.6487 59.454C38.9268 58.9457 40.1522 58.3313 41.3136 57.6214C43.8233 56.6585 46.5594 56.1607 49.4136 56.2312C61.1004 56.5201 70.3403 66.2283 70.0515 77.9151C69.7638 89.5531 60.1355 98.7645 48.5142 98.5562C46.8296 98.5037 45.1905 98.2778 43.614 97.8961Z\" fill=\"#C7EE30\"/></symbol>\r\n  <symbol id=\"i-signal\" viewBox=\"0 0 24 24\"><path d=\"M5 17.5v-2M9 17.5v-5M13 17.5v-8M17 17.5V6.5\" stroke-width=\"2.2\"/></symbol>\r\n  <symbol id=\"i-wifi\" viewBox=\"0 0 24 24\"><path d=\"M4.5 10a11 11 0 0 1 15 0M7.25 13a7 7 0 0 1 9.5 0M10 16a3 3 0 0 1 4 0\" stroke-width=\"2\"/></symbol>\r\n  <symbol id=\"i-batterie\" viewBox=\"0 0 24 24\"><rect x=\"3.75\" y=\"7.75\" width=\"14.5\" height=\"8.5\" rx=\"2\" stroke-width=\"1.4\"/><rect x=\"5.5\" y=\"9.5\" width=\"9\" height=\"5\" rx=\"1\" fill=\"currentColor\" stroke=\"none\"/><path d=\"M20.25 10.75v2.5\" stroke-width=\"1.6\"/></symbol>\r\n</svg>","styles":"@font-face {\n  font-family: 'WuraMi';\n  src: url(data:font/woff2;base64,) format('woff2');\n  font-weight: 300;\n  font-style: normal;\n  font-display: block;\n}\n\n@font-face {\n  font-family: 'WuraMi';\n  src: url(data:font/woff2;base64,) format('woff2');\n  font-weight: 400;\n  font-style: normal;\n  font-display: block;\n}\n\n@font-face {\n  font-family: 'WuraMi';\n  src: url(data:font/woff2;base64,) format('woff2');\n  font-weight: 600;\n  font-style: normal;\n  font-display: block;\n}\n\n@font-face {\n  font-family: 'WuraMi';\n  src: url(data:font/woff2;base64,) format('woff2');\n  font-weight: 700;\n  font-style: normal;\n  font-display: block;\n}\n\n/* ---- styles/tokens.css ---- */\n:root {\n  /* Le fond d e-freeshop, a la valeur pres : un lavande tres clair. */\n  --fond: hsl(229 36% 92%);\n  --texte: hsl(0 0% 7%);\n  --discret: hsl(215 16% 47%);\n  --carte: hsl(0 0% 100%);\n  --secondaire: hsl(240 10% 96%);\n  --bord: hsl(240 6% 90%);\n\n  /* Un role par couleur. L ocean : ce qui se clique et l etape en cours.\n     La limonade : ce qui est sur, fait, valide. */\n  --ocean: hsl(229 97% 55%);\n  --limonade: hsl(71 88% 56%);\n  --erreur: hsl(0 84% 60%);\n\n  --courbe: cubic-bezier(0.22, 1, 0.36, 1);\n  --souple: cubic-bezier(0.16, 1, 0.3, 1);\n  /* Le rebond de l appui, celui des controles d iOS. */\n  --ressort: cubic-bezier(0.34, 1.56, 0.64, 1);\n\n  /* La marge de page : le logo touche le bord gauche, le profil le droit. */\n  --marge: clamp(1rem, 4vw, 3.5rem);\n}\n\n/* ---- styles/verre.css ---- */\n/* Le verre liquide, d apres celui d Apple et le curseur de Noomo,\n   sur le fond lavande de la page. C est de l eau plus que du verre : presque\n   rien dans la masse, tout se joue sur les bords et a la surface.\n   Quatre couches :\n   1. la masse : transparente. La lentille (useVerreLiquide) courbe le fond\n      le long des aretes ; une ombre fine sous l arete du haut et une clarte\n      au bas donnent l epaisseur d une goutte ;\n   2. l arete speculaire (::before) : un filet de lumiere qui tourne vers\n      le pointeur, vif d un cote, doux de l autre ;\n   3. l onde (::after) : au survol, un cercle de lumiere part de la main et\n      s elargit a la surface, comme sur l eau qu on touche ;\n   4. l ombre portee, douce.\n   Deux epaisseurs : .verre pour les controles et ce qui flotte, .verre-plaque\n   pour les grandes surfaces.\n   La plaque est A PLAT (2026-10-23, comme les cartes des Parametres du\n   telephone et de Bloc-notes) : un fond plein un ton au-dessus de la page,\n   ni bord, ni ombre, ni relief. Seul ce qui flotte (feuille, dialogue, apercu\n   sur la carte, mentions, pastille d envoi) garde l arete et l ombre du verre. */\n\n/* Le rayon de l onde. Declare, il peut s animer. */\n@property --onde {\n  syntax: '<percentage>';\n  inherits: false;\n  initial-value: 0%;\n}\n\n.verre,\n.verre-plaque {\n  position: relative;\n  isolation: isolate;\n}\n\n.verre {\n  /* Pas de flou de repli : sur un fond uni il ne se verrait pas, et il\n     couterait cher. La lentille, elle, est posee par useVerreLiquide. */\n  background: linear-gradient(\n    180deg,\n    hsl(0 0% 100% / 0.1),\n    hsl(0 0% 100% / 0.02) 40%,\n    hsl(0 0% 100% / 0.07)\n  );\n  box-shadow:\n    inset 0 1px 0.5px hsl(0 0% 100% / 0.9),\n    inset 0 -1px 0.5px hsl(0 0% 100% / 0.5),\n    inset 0 6px 9px -7px hsl(229 55% 30% / 0.22),\n    inset 0 -6px 8px -7px hsl(0 0% 100% / 0.5),\n    0 0 0 0.5px hsl(229 40% 30% / 0.14),\n    0 10px 24px -14px hsl(229 50% 20% / 0.36);\n}\n\n.verre-plaque {\n  background: hsl(0 0% 100% / 0.8);\n}\n.verre-plaque:is(.feuille, .dialogue, .carte-apercu, .mentions, .envoi-pastille, .lieu-choisi) {\n  /* Pas de backdrop-filter ici : il couperait les verres poses dessus du\n     fond de la page, et leur lentille n aurait plus rien a courber. */\n  box-shadow:\n    inset 0 1px 0.5px hsl(0 0% 100% / 0.9),\n    inset 0 -1px 0.5px hsl(0 0% 100% / 0.45),\n    inset 0 14px 24px -18px hsl(229 55% 30% / 0.14),\n    0 0 0 0.5px hsl(229 40% 30% / 0.1),\n    0 40px 80px -48px hsl(229 50% 20% / 0.35);\n}\n\n/* L arete : un anneau de 1,25px peint par un degrade conique dont le point\n   le plus vif regarde le pointeur (--angle, ecrit par useLumiere). */\n.verre::before,\n.verre-plaque:is(.feuille, .dialogue, .carte-apercu, .mentions, .envoi-pastille, .lieu-choisi)::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  z-index: -1;\n  padding: 1.25px;\n  border-radius: inherit;\n  pointer-events: none;\n  background: conic-gradient(\n    from var(--angle, 315deg),\n    hsl(0 0% 100% / 1) 0deg,\n    hsl(0 0% 100% / 0.35) 50deg,\n    hsl(0 0% 100% / 0.05) 110deg,\n    hsl(0 0% 100% / 0.6) 180deg,\n    hsl(0 0% 100% / 0.05) 250deg,\n    hsl(0 0% 100% / 0.35) 310deg,\n    hsl(0 0% 100% / 1) 360deg\n  );\n  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);\n  -webkit-mask-composite: xor;\n  mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);\n}\n\n/* L onde : un anneau de lumiere centre sur la main (--lx, --ly, ecrits par\n   useLumiere). Au repos son rayon est nul et il ne se voit pas. */\n.verre::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  z-index: -1;\n  border-radius: inherit;\n  pointer-events: none;\n  opacity: 0;\n  background: radial-gradient(\n    circle farthest-corner at var(--lx, 50%) var(--ly, 50%),\n    hsl(0 0% 100% / 0.14) 0%,\n    hsl(0 0% 100% / 0.05) calc(var(--onde) - 32%),\n    /* Le creux, un peu plus sombre, juste derriere la crete claire. */\n    hsl(229 70% 45% / 0.1) calc(var(--onde) - 15%),\n    hsl(0 0% 100% / 0.62) calc(var(--onde) - 4%),\n    hsl(0 0% 100% / 0.2) var(--onde),\n    transparent calc(var(--onde) + 8%)\n  );\n}\n\n@media (hover: hover) {\n  .verre:hover::after { animation: onde 1.25s cubic-bezier(0.2, 0.6, 0.3, 1) both; }\n}\n/* Sous le doigt ou le clic, l onde repart. */\n.verre-appuyable:active:not(:disabled)::after { animation: onde-appui 0.9s cubic-bezier(0.2, 0.6, 0.3, 1) both; }\n\n@keyframes onde {\n  0%   { --onde: 0%; opacity: 0; }\n  14%  { opacity: 1; }\n  70%  { opacity: 0.7; }\n  100% { --onde: 125%; opacity: 0; }\n}\n@keyframes onde-appui {\n  0%   { --onde: 0%; opacity: 1; }\n  100% { --onde: 125%; opacity: 0; }\n}\n\n/* L appui : la goutte se tasse, puis revient avec un leger rebond. Au\n   survol elle gonfle a peine. */\n.verre-appuyable {\n  transition: transform 0.5s var(--ressort), background-color 0.3s var(--courbe), opacity 0.2s var(--courbe);\n}\n@media (hover: hover) {\n  .verre-appuyable:hover:not(:disabled) { transform: scale(1.012); }\n}\n.verre-appuyable:active:not(:disabled) { transform: scale(0.965); transition-duration: 0.12s; }\n\n/* L eau teintee d ocean, pour l action principale de l ecran. */\n.verre.plein {\n  background: linear-gradient(180deg, hsl(229 97% 60% / 0.8), hsl(229 97% 52% / 0.84));\n  color: #fff;\n  box-shadow:\n    inset 0 1px 0.5px hsl(0 0% 100% / 0.6),\n    inset 0 -1px 0.5px hsl(0 0% 100% / 0.25),\n    inset 0 7px 10px -7px hsl(229 90% 20% / 0.3),\n    inset 0 -9px 12px -9px hsl(200 100% 80% / 0.5),\n    0 0 0 0.5px hsl(229 90% 30% / 0.35),\n    0 14px 30px -14px hsl(229 97% 45% / 0.65);\n}\n.verre.plein::before { opacity: 0.7; }\n\n/* Le verre retenu : une carte ou une pastille choisie prend l ocean. */\n.verre[aria-checked='true'] {\n  background: hsl(229 97% 55% / 0.1);\n  box-shadow:\n    inset 0 0 0 1.5px var(--ocean),\n    inset 0 1px 0.5px hsl(0 0% 100% / 0.75),\n    0 10px 24px -14px hsl(229 97% 45% / 0.4);\n}\n\n.lentille-filtre {\n  position: absolute;\n  width: 0;\n  height: 0;\n  pointer-events: none;\n}\n\n/* ---- styles/boutons.css ---- */\n/* Les actions d appoint : du texte seul, sans socle. Le verre est reserve\n   aux vraies actions (voir verre/BoutonVerre.css). */\n.bouton-discret {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.4rem;\n  min-height: 3.1rem;\n  padding: 0 0.9rem;\n  border: none;\n  border-radius: 14px;\n  background: transparent;\n  color: var(--discret);\n  font: inherit;\n  font-weight: 600;\n  font-size: 0.95rem;\n  cursor: pointer;\n  transition: color 0.15s var(--courbe);\n}\n.bouton-discret svg { width: 1.05rem; height: 1.05rem; }\n.bouton-discret:focus-visible { outline: 2px solid var(--ocean); outline-offset: 2px; }\n.bouton-discret:disabled { opacity: 0.4; cursor: not-allowed; }\n.bouton-discret.petit { min-height: 2rem; padding: 0 0.4rem; font-size: 0.85rem; }\n\n/* La croix qui retire un fichier ou un destinataire. */\n.croix {\n  display: inline-flex;\n  flex: none;\n  align-items: center;\n  justify-content: center;\n  width: 2rem;\n  height: 2rem;\n  border: none;\n  border-radius: 50%;\n  background: transparent;\n  color: var(--discret);\n  cursor: pointer;\n  transition: color 0.15s var(--courbe), background 0.15s var(--courbe);\n}\n.croix svg { width: 1.05rem; height: 1.05rem; }\n.croix:focus-visible { background: hsl(0 0% 100% / 0.6); outline: none; }\n\n/* Le jeton d initiales, pour le compte et les collegues. */\n.jeton {\n  display: inline-flex;\n  flex: none;\n  align-items: center;\n  justify-content: center;\n  width: 2rem;\n  height: 2rem;\n  border-radius: 50%;\n  background: var(--texte);\n  color: #fff;\n  font-weight: 600;\n  font-size: 0.8rem;\n}\n\n/* Les sorties (Annuler, Fermer, retirer) rougissent : on voit qu on\n   s apprete a defaire quelque chose. */\n.sortie { transition: color 0.2s var(--courbe); }\n.sortie:focus-visible,\n.sortie:active:not(:disabled),\n.croix:focus-visible,\n.croix:active { color: var(--erreur); }\n\n/* Le survol n existe qu avec une souris : sur un ecran tactile il resterait\n   colle au dernier bouton touche. */\n@media (hover: hover) {\n  .bouton-discret:hover:not(:disabled) { color: var(--texte); }\n  .croix:hover { background: hsl(0 0% 100% / 0.6); }\n  .sortie:hover:not(:disabled),\n  .croix:hover { color: var(--erreur); }\n\n  /* Les icones se retracent au survol de leur bouton, trait apres trait,\n     sans hate. Chaque trait mesure 1 (pathLength, voir pieces/Icone.tsx). */\n  :is(button, a):hover:not(:disabled) .icone :is(path, circle, rect) {\n    stroke-dasharray: 1 2;\n    animation: icone-trace 1.5s cubic-bezier(0.5, 0, 0.2, 1) both;\n  }\n  :is(button, a):hover:not(:disabled) .icone :nth-child(2) { animation-delay: 0.22s; }\n  :is(button, a):hover:not(:disabled) .icone :nth-child(3) { animation-delay: 0.44s; }\n  :is(button, a):hover:not(:disabled) .icone :nth-child(4) { animation-delay: 0.66s; }\n}\n@keyframes icone-trace {\n  from { stroke-dashoffset: 1; }\n  to   { stroke-dashoffset: 0; }\n}\n\n/* Au doigt, les petites cibles grandissent jusqu a 44px. */\n@media (pointer: coarse) {\n  .croix { width: 2.75rem; height: 2.75rem; }\n  .bouton-discret.petit { min-height: 2.75rem; padding: 0 0.6rem; }\n}\n\n/* ---- styles/bouton-verre.css ---- */\n/* Le bouton : un rectangle arrondi, pas une pilule, fait de verre liquide. */\n.bouton-verre {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 3.1rem;\n  padding: 0 1.25rem;\n  border: none;\n  border-radius: 14px;\n  color: var(--texte);\n  font: inherit;\n  font-weight: 600;\n  font-size: 0.95rem;\n  line-height: 1;\n  white-space: nowrap;\n  cursor: pointer;\n}\n\n.bouton-verre-texte {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.55rem;\n}\n.bouton-verre-texte svg { width: 1.1rem; height: 1.1rem; }\n\n.bouton-verre .fleche { display: inline-flex; transition: transform 0.35s var(--ressort); }\n.bouton-verre:focus-visible { outline: 2px solid var(--ocean); outline-offset: 3px; }\n.bouton-verre:disabled { opacity: 0.38; cursor: not-allowed; }\n\n@media (hover: hover) {\n  .bouton-verre:hover:not(:disabled) .fleche { transform: translateX(3px); }\n  .bouton-verre.plein:hover:not(:disabled) { filter: saturate(1.15) brightness(1.04); }\n}\n\n/* ---- styles/base.css ---- */\n/* Le socle des ecrans de USW : la page d un telephone ou d une tablette.\n   Les couleurs, le verre et les boutons sont ceux de SafeVault, tels quels\n   (tokens.css, verre.css, boutons.css, bouton-verre.css). */\n\n* { box-sizing: border-box; }\nhtml, body { margin: 0; padding: 0; }\nhtml { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; -webkit-tap-highlight-color: transparent; }\n\nbody {\n  background: var(--fond);\n  color: var(--texte);\n  font-family: 'WuraMi', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;\n  font-size: 15px;\n  line-height: 1.4;\n  -webkit-font-smoothing: antialiased;\n  overflow-x: hidden;\n}\n\nbutton { font: inherit; color: inherit; }\n\n/* Les courbes de la charte du mouvement (MOUVEMENT.md, section 1). */\n:root {\n  --signature: cubic-bezier(0.35, 0, 0, 1);\n  --interface: cubic-bezier(0.4, 0, 0.1, 1);\n  --marge-app: 16px;\n  --haut-onglets: 64px;\n}\n@media (min-width: 600px) {\n  :root { --marge-app: 28px; --haut-onglets: 68px; }\n  body { font-size: 16px; }\n}\n\n/* Une icone du pack USW : a l encre, trait appuye comme les symboles d iOS.\n   Jamais de bleu ni de pastille bleue derriere une icone ; seules les icones\n   d information gardent les couleurs de Google. */\n.ic {\n  width: 24px;\n  height: 24px;\n  flex: none;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 1.5;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n.ic.petite { width: 18px; height: 18px; }\n.ic.mini { width: 15px; height: 15px; }\n\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after {\n    animation-duration: 0.2s !important;\n    animation-delay: 0s !important;\n    transition-duration: 0.01ms !important;\n  }\n}\n\n/* Lu par le lecteur d ecran, invisible a l oeil : les champs de compte n ont\n   pas de libelle au-dessus, leur indication dit quoi ecrire (2026-10-23). */\n.pour-lecteur {\n  position: absolute !important;\n  width: 1px;\n  height: 1px;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n}\n\n/* ---- styles/usw.css ---- */\n/* USW, United State of World : les ecrans.\n   La structure suit les ecrans de Pinterest du projet (reference_screenshots) :\n   mosaique, epingle, recherche par idees, profil. La matiere est celle de\n   SafeVault : fond lavande, verre liquide, ocean pour ce qui se clique,\n   limonade pour ce qui est sur (la capture verifiee). Le mouvement suit\n   MOUVEMENT.md : chaque animation part d un etat cache et finit sur le style\n   de base, que l atelier montre fige sur la toile. */\n\n/* ------------------------------------------------------------ l application */\n/* Un telephone ne montre pas de barre de defilement. */\nhtml { scrollbar-width: none; }\n.app {\n  position: relative;\n  min-height: 100vh;\n  isolation: isolate;\n}\n.app.fixe { height: 100vh; overflow: hidden; }\n\n/* La barre d etat du telephone. */\n.barre-etat {\n  position: relative;\n  z-index: 30;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  height: 34px;\n  padding: 0 calc(var(--marge-app) + 6px);\n  font-size: 13.5px;\n  font-weight: 600;\n  letter-spacing: 0.01em;\n}\n.barre-etat .etat-icones { display: inline-flex; gap: 2px; align-items: center; }\n.barre-etat .ic { width: 17px; height: 17px; }\n.sombre .barre-etat, .barre-etat.claire { color: #fff; }\n\n/* ------------------------------------------------------------ la barre d onglets */\n.onglets {\n  position: fixed;\n  z-index: 40;\n  left: 50%;\n  bottom: 14px;\n  translate: -50% 0;\n  width: min(100% - 2 * var(--marge-app), 440px);\n  height: var(--haut-onglets);\n  display: flex;\n  align-items: center;\n  justify-content: space-around;\n  padding: 0 8px;\n  border-radius: 999px;\n  /* Sur les photos, le verre seul ne se lirait pas : il prend un voile givre. */\n  background: linear-gradient(180deg, hsl(0 0% 100% / 0.62), hsl(229 40% 96% / 0.5));\n  -webkit-backdrop-filter: blur(18px) saturate(1.7);\n  backdrop-filter: blur(18px) saturate(1.7);\n  animation: onglets-entre 0.9s 0.45s var(--signature) both;\n}\n.onglet {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 52px;\n  height: 46px;\n  border: none;\n  border-radius: 999px;\n  background: transparent;\n  color: hsl(229 15% 35%);\n}\n/* L onglet actif : l icone passe a l encre et a sa version pleine, sans pastille ni point. */\n.onglet[aria-current='page'] { color: var(--texte); }\n.onglet[aria-current='page'] .ic { --ic-contour: none; --ic-plein: inline; }\n.onglet.creer {\n  width: 50px;\n  height: 50px;\n  color: #fff;\n}\n.onglet.creer .ic { width: 26px; height: 26px; stroke-width: 2.1; }\n\n.sombre .onglets {\n  background: linear-gradient(180deg, hsl(229 30% 12% / 0.42), hsl(229 30% 6% / 0.5));\n  box-shadow: inset 0 1px 0.5px hsl(0 0% 100% / 0.35), inset 0 -1px 0.5px hsl(0 0% 100% / 0.12), 0 10px 30px -12px hsl(0 0% 0% / 0.6);\n}\n.sombre .onglet { color: hsl(0 0% 100% / 0.78); }\n.sombre .onglet[aria-current='page'] { color: #fff; }\n\n/* ------------------------------------------------------------ les pieces */\n\n/* Le bouton rond de verre : retour, plus, fermer. */\n.rond-verre {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 44px;\n  height: 44px;\n  border: none;\n  border-radius: 50%;\n  color: var(--texte);\n}\n.rond-verre.givre {\n  background: hsl(0 0% 100% / 0.55);\n  -webkit-backdrop-filter: blur(14px) saturate(1.6);\n  backdrop-filter: blur(14px) saturate(1.6);\n}\n\n/* La pastille de filtre : un verre fin, comme les controles. */\n.pastille {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  height: 36px;\n  padding: 0 14px;\n  border: none;\n  border-radius: 999px;\n  font-size: 13.5px;\n  font-weight: 600;\n  white-space: nowrap;\n  color: var(--texte);\n}\n.pastille .ic { width: 16px; height: 16px; }\n/* La pastille choisie passe a l encre : pas de contour ni de fond bleu. */\n.pastille.verre[aria-checked='true'] { color: #fff; background: var(--texte); box-shadow: none; }\n.pastille.verre[aria-checked='true']::before, .pastille.verre[aria-checked='true']::after { opacity: 0; }\n\n/* Le badge de capture : la limonade dit ce qui est sur. */\n.badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  height: 26px;\n  padding: 0 10px 0 7px;\n  border-radius: 999px;\n  font-size: 12px;\n  font-weight: 600;\n  white-space: nowrap;\n}\n.badge .ic { width: 16px; height: 16px; stroke-width: 2; }\n.badge.verifie { background: var(--limonade); color: hsl(71 60% 14%); }\n.badge.declare { background: hsl(0 0% 100% / 0.7); color: var(--discret); box-shadow: inset 0 0 0 1px hsl(229 30% 30% / 0.14); }\n\n/* Les initiales d un createur : pas de visage invente. */\n.avatar {\n  display: inline-flex;\n  flex: none;\n  align-items: center;\n  justify-content: center;\n  width: 40px;\n  height: 40px;\n  border-radius: 50%;\n  color: #fff;\n  font-weight: 700;\n  font-size: 15px;\n  background: var(--teinte, var(--ocean));\n}\n.avatar.petit { width: 30px; height: 30px; font-size: 12px; }\n\n/* Une photo : le fond est pose par l assembleur (.ph-pNN), avec ses\n   proportions ; la couleur dominante tient la place pendant le chargement. */\n.photo {\n  display: block;\n  width: 100%;\n  background-color: hsl(229 25% 84%);\n  background-size: cover;\n  background-position: center;\n}\n\n/* La mesure discrete d un compteur. */\n.compte { font-size: 13px; font-weight: 600; white-space: nowrap; }\n\n/* ------------------------------------------------------------ le logo qui tourne */\n/* Comme un yin et yang, dans le sens inverse des aiguilles : l ouverture et\n   toute attente (jamais de cercle de progression). Transform seulement. */\n.logo-tourne { width: 26px; height: 26px; animation: tourne 1.8s linear infinite; }\n@keyframes tourne { to { transform: rotate(-1turn); } }\n@media (prefers-reduced-motion: reduce) { .logo-tourne { animation: none; } }\n\n/* ------------------------------------------------------------ E00 ouverture */\n.ouverture .logo-tourne { width: 72px; height: 72px; margin: 0 auto 26px; animation-duration: 2.4s; }\n.ouverture {\n  display: grid;\n  place-items: center;\n  height: 100vh;\n  overflow: hidden;\n  background: var(--fond);\n}\n.ouverture .barre-etat { position: absolute; top: 0; left: 0; right: 0; }\n.ouverture-coeur { position: relative; text-align: center; }\n\n.sigle {\n  position: relative;\n  margin: 0;\n  display: inline-flex;\n  align-items: baseline;\n  font-size: clamp(30px, 7.4vw, 60px);\n  font-weight: 700;\n  letter-spacing: -0.035em;\n  line-height: 1.1;\n  white-space: nowrap;\n  /* Tout se pose sans a-coup : une seule courbe, longue, qui ralentit a la fin. */\n  --souple: cubic-bezier(0.22, 1, 0.36, 1);\n}\n.sigle .mot { display: inline-flex; align-items: baseline; }\n.sigle > * + * { margin-left: 0.24em; }\n.sigle .initiale {\n  display: inline-block;\n  color: var(--ocean);\n  /* U, puis S, puis W : chacune monte seule, la suivante attend. */\n  animation: initiale 1.1s calc(0.2s + var(--i) * 0.45s) var(--souple) both;\n}\n/* Le W prend la limonade. */\n.sigle .initiale.citron { color: var(--limonade); }\n/* Puis les mots se deroulent un par un, chacun a son tour (--t). */\n.sigle .suite {\n  display: inline-flex;\n  overflow: hidden;\n  max-width: var(--l);\n  padding-bottom: 0.14em;\n  margin-bottom: -0.14em;\n  animation: deroule 1.2s var(--t) var(--souple) both;\n}\n.sigle .suite > span {\n  display: inline-block;\n  animation: lettre 1s calc(var(--t) + 0.1s + var(--j) * 0.06s) var(--souple) both;\n}\n/* L espace avant un mot s ouvre avec le mot qui le precede (--e). */\n.sigle .mot:not(:first-child) { animation: ecarte 1.2s var(--e) var(--souple) both; }\n.sigle .of {\n  display: inline-flex;\n  overflow: hidden;\n  max-width: 1.1em;\n  padding-bottom: 0.14em;\n  margin-bottom: -0.14em;\n  font-weight: 300;\n  color: var(--discret);\n  animation: petit-mot 1.1s var(--t) var(--souple) both;\n}\n.sigle .of > span { display: inline-block; animation: lettre 1s calc(var(--t) + 0.1s) var(--souple) both; }\n@keyframes initiale { from { transform: translateY(0.6em); opacity: 0; } }\n@keyframes deroule { from { max-width: 0; } }\n@keyframes lettre { from { transform: translateY(110%); opacity: 0; } }\n@keyframes ecarte { from { margin-left: 0; } }\n@keyframes petit-mot { from { max-width: 0; margin-left: 0; } }\n\n/* ------------------------------------------------------------ E03 piles de lieux */\n/* A l accueil, chaque lieu est une pile de ses photos, rangee comme un\n   paquet : les photos de derriere sont alignees sur celle de devant, un peu\n   plus petites, et ne depassent qu en haut. Toutes les 4 s, la photo de\n   devant glisse vers le bas en s effacant, la suivante avance a sa place\n   (0,8 s, sans rebond : un seul mouvement, facile a suivre), et celle qui est\n   partie revient au fond sans se voir. 4 photos, un tour en 16 s ; les piles\n   tournent l une apres l autre (--d), jamais toutes ensemble.\n   Le style de base est la pile au repos. Toucher la pile ouvre le lieu (E33). */\n.pile-lieu {\n  break-inside: avoid;\n  margin: 0 0 18px;\n  animation: carte 1.4s calc(0.35s + var(--n, 0) * 0.07s) var(--signature) both;\n}\n.pile {\n  position: relative;\n  display: grid;\n  margin-top: 16px;\n  /* L ordre des photos se joue en profondeur (translateZ) et non en z-index :\n     l animation ne touche que transform et opacite, le telephone la fait\n     tourner sans recalculer la page. */\n  transform-style: preserve-3d;\n}\n.pile-carte {\n  --pile-courbe: cubic-bezier(0.22, 1, 0.36, 1);\n  grid-area: 1 / 1;\n  overflow: hidden;\n  border-radius: 18px;\n  background: hsl(229 25% 84%);\n  transform-origin: 50% 0;\n  animation: pile 16s calc(var(--k) * 4s - 17.6s + var(--d, 0s)) var(--pile-courbe) infinite both;\n}\n.pile-carte .photo {\n  height: 100%;\n  aspect-ratio: auto;\n  animation: pile-image 16s calc(var(--k) * 4s - 17.6s + var(--d, 0s)) var(--pile-courbe) infinite both;\n}\n/* 3 devant, 2 et 1 derriere, 0 partie ; celle qui part passe a 5 pour rester dessus. */\n.pile-carte:nth-child(1) { transform: translateZ(3px); }\n.pile-carte:nth-child(2) { transform: translateZ(2px) translateY(-8px) scale(0.93); opacity: 0.75; }\n.pile-carte:nth-child(3) { transform: translateZ(1px) translateY(-15px) scale(0.86); opacity: 0.45; }\n.pile-carte:nth-child(4) { transform: translateZ(0) translateY(12%) scale(0.98); opacity: 0; }\n.pile-carte:not(:first-child) .photo { transform: scale(1.1); }\n.pile-lieu .carte-pied { padding-top: 9px; }\n/* Le tour d une photo, a partir du moment ou elle passe devant :\n   0-5 % elle avance, 25-30 % elle glisse et s efface, 50-55 % elle revient\n   au fond, 75-80 % elle monte d un rang. */\n@keyframes pile {\n  0%     { transform: translateZ(3px) translateY(-8px) scale(0.93); opacity: 0.75; }\n  5%     { transform: translateZ(3px); opacity: 1; }\n  24.99% { transform: translateZ(3px); opacity: 1; }\n  25%    { transform: translateZ(5px); opacity: 1; }\n  30%    { transform: translateZ(5px) translateY(12%) scale(0.98); opacity: 0; }\n  49.99% { transform: translateZ(5px) translateY(12%) scale(0.98); opacity: 0; }\n  50%    { transform: translateZ(0px) translateY(12%) scale(0.98); opacity: 0; }\n  55%    { transform: translateZ(0px) translateY(-15px) scale(0.86); opacity: 0.45; }\n  74.99% { transform: translateZ(0px) translateY(-15px) scale(0.86); opacity: 0.45; }\n  75%    { transform: translateZ(2px) translateY(-15px) scale(0.86); opacity: 0.45; }\n  80%    { transform: translateZ(2px) translateY(-8px) scale(0.93); opacity: 0.75; }\n  99.99% { transform: translateZ(2px) translateY(-8px) scale(0.93); opacity: 0.75; }\n  100%   { transform: translateZ(3px) translateY(-8px) scale(0.93); opacity: 0.75; }\n}\n/* L image se recadre doucement quand sa photo arrive devant. */\n@keyframes pile-image {\n  0% { transform: scale(1.1); }\n  9%, 100% { transform: scale(1); }\n}\n\n/* ------------------------------------------------------------ E33 lieu */\n.entete-lieu {\n  position: sticky;\n  top: 0;\n  z-index: 20;\n  padding: 0 var(--marge-app) 8px;\n  background: var(--fond);\n}\n.lieu-titre { margin: 6px 0 6px; font-size: 28px; font-weight: 700; letter-spacing: -0.03em; line-height: 1.1; }\n.lieu-ligne { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; }\n.lieu-infos { display: inline-flex; align-items: center; gap: 5px; font-size: 14px; font-weight: 600; color: var(--discret); animation: monte 0.9s 0.4s var(--signature) both; }\n.lieu-infos .ic { width: 17px; height: 17px; }\n.lieu-ligne .bouton-verre { animation: monte 0.9s 0.5s var(--signature) both; }\n\n/* ------------------------------------------------------------ l en-tete qui se range */\n/* A l accueil et sur un lieu, l en-tete (titre, flux, filtres) ne reste pas\n   fige : quand on descend, il se range sous la barre d etat et les photos\n   prennent tout l ecran ; des qu on remonte, il revient en entier. Un petit\n   script pose la classe .range (la toile de l atelier ne l execute pas :\n   l en-tete y est affiche). La barre d etat, elle, reste, pleine. */\n.app:has(> .entete-mobile) > .barre-etat {\n  position: sticky;\n  top: 0;\n}\n/* Sous l heure et les icones, pas de coupure nette : un voile lavande\n   (le fond a 85 %) un peu floute, qui s efface vers le bas, comme la barre\n   de Sika. Il deborde de la barre pour que les photos y entrent en douceur. */\n.app:has(> .entete-mobile) > .barre-etat::before,\n.entete-mobile::after {\n  content: '';\n  position: absolute;\n  z-index: -1;\n  pointer-events: none;\n  background: hsl(229 36% 92% / 0.85);\n  -webkit-backdrop-filter: blur(4px);\n  backdrop-filter: blur(4px);\n  -webkit-mask-image: linear-gradient(#000 45%, #0000);\n  mask-image: linear-gradient(#000 45%, #0000);\n}\n.app:has(> .entete-mobile) > .barre-etat::before { inset: 0 0 -26px; }\n/* Le bas de l en-tete se fond de la meme facon dans les photos. */\n.entete-mobile::after { left: 0; right: 0; top: calc(100% - 1px); height: 26px; -webkit-mask-image: linear-gradient(#000, #0000); mask-image: linear-gradient(#000, #0000); }\n.entete-mobile {\n  top: 34px;\n  transition: transform 0.45s cubic-bezier(0.4, 0, 0.1, 1);\n}\n.entete-mobile.range { transform: translateY(-100%); }\n\n/* ------------------------------------------------------------ au defilement */\n/* Une fois la pile deliee (la page du lieu, E33, ouverte en touchant une pile\n   de l accueil), ses photos entrent comme les projets de Nentem : quand une\n   carte monte dans l ecran, elle arrive de son cote (colonne de gauche par la\n   gauche, de droite par la droite, celle du milieu tout droit) en se\n   redressant, elle grandit de 80 % a 100 % et l image se recadre\n   (1,3 -> 1). Transform seulement : l animation tourne hors du fil\n   principal, liee au defilement. Le mouvement suit le doigt : il avance et recule avec\n   le defilement, et se termine quand la carte est entree en entier. Les\n   cartes deja visibles a l ouverture sont posees. La colonne (--cp au\n   telephone, --ct a la tablette, -1 / 0 / 1) est mesuree dans Chrome\n   (outils/colonnes.mjs), car une mosaique en colonnes ne la donne pas. */\n.lieu-page .mosaique > * { --cote: var(--cp, 0); }\n@media (min-width: 600px) { .lieu-page .mosaique > * { --cote: var(--ct, 0); } }\n@supports (animation-timeline: view()) {\n  .lieu-page .mosaique .carte-image {\n    animation: defile-entre linear both;\n    animation-timeline: view();\n    animation-range: entry 0% entry 100%;\n    /* L image est dans ce cadre qui la coupe (overflow), qui serait son\n       propre defilement : elle suit donc la ligne de temps du cadre. */\n    view-timeline-name: --carte;\n  }\n  .lieu-page .mosaique .carte-image .photo {\n    animation: defile-image linear both;\n    animation-timeline: --carte;\n    animation-range: entry 0% entry 100%;\n  }\n  .lieu-page .mosaique .carte-pied {\n    animation: defile-pied linear both;\n    animation-timeline: view();\n    animation-range: entry 40% entry 100%;\n  }\n}\n@keyframes defile-entre {\n  from {\n    transform: translateX(calc(var(--cote) * 5vw)) rotate(calc(var(--cote) * 3deg)) scale(0.8);\n    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);\n  }\n  to { transform: none; }\n}\n@keyframes defile-image {\n  from { transform: scale(1.3); animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1); }\n  to { transform: none; }\n}\n@keyframes defile-pied {\n  from { transform: translateY(14px); opacity: 0; animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1); }\n  to { transform: none; opacity: 1; }\n}\n\n/* ------------------------------------------------------------ entrees communes */\n@keyframes monte { from { transform: translateY(1em); opacity: 0; } }\n@keyframes mot { from { transform: translateY(1.7em) rotate(15deg); } }\n@keyframes onglets-entre { from { transform: translateY(140%) scale(0.92); } }\n/* Une carte se pose : elle monte et grandit de 94 % a 100 %. Transform et\n   opacite seulement : le telephone l anime sans recalculer la page. */\n@keyframes carte {\n  from { transform: translateY(36px) scale(0.94); opacity: 0; }\n  40% { opacity: 1; }\n}\n@keyframes fondu { from { opacity: 0; } }\n\n/* Un texte coupe en mots, qui montent un a un. */\n.mots .m { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: 0.1em; margin-bottom: -0.1em; }\n.mots .m > span { display: inline-block; }\n/* Les mots qui montent un a un : reserves aux pages qui se levent (la\n   bienvenue) et au haut d un lieu. Ailleurs le titre est immobile : trop\n   frequent, l effet perdrait son sens (2026-10-23). */\n:is(.bienvenue, .lieu-page, .ouverture) .mots .m > span { animation: mot 1s calc(0.25s + var(--k, 0) * 0.05s) var(--signature) both; }\n\n/* ------------------------------------------------------------ E03 accueil */\n/* Epure (2026-10-23) : le logo et « USW », la loupe, la cloche ; les flux et\n   les filtres passent dans la recherche. Le fond s efface vers le bas, sans\n   flou : les photos glissent dessous. */\n.entete-accueil {\n  position: sticky;\n  top: 0;\n  z-index: 20;\n  padding: 0 var(--marge-app) 18px;\n  background: linear-gradient(180deg, var(--fond) 55%, hsl(229 36% 92% / 0));\n}\n.entete-accueil .rond-verre { background: transparent; box-shadow: inset 0 1px 0.5px hsl(0 0% 100% / 0.9), 0 0 0 0.5px hsl(229 40% 30% / 0.14); }\n.entete-ligne {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  height: 52px;\n}\n.marque {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 22px;\n  font-weight: 700;\n  letter-spacing: -0.04em;\n}\n.logo { display: block; flex: none; width: 30px; height: 30px; }\n.marque .logo { width: 30px; height: 30px; }\n.entete-actions { display: inline-flex; gap: 6px; }\n.point-nouveau {\n  position: absolute;\n  top: 9px;\n  right: 10px;\n  width: 9px;\n  height: 9px;\n  border-radius: 50%;\n  background: var(--erreur);\n  box-shadow: 0 0 0 2px var(--fond);\n}\n.rond-verre { position: relative; }\n\n/* Les trois flux : des onglets de texte souligne, comme le « Tout » de Pinterest. */\n.flux {\n  display: flex;\n  gap: 22px;\n  margin: 2px 0 12px;\n  font-size: 16px;\n  font-weight: 600;\n  color: var(--discret);\n}\n.flux span { position: relative; padding: 6px 0; }\n.flux span[aria-current='true'] { color: var(--texte); }\n.flux span[aria-current='true']::after {\n  content: '';\n  position: absolute;\n  left: 0; right: 0; bottom: 0;\n  height: 3px;\n  border-radius: 3px;\n  background: var(--texte);\n  animation: souligne 0.6s 0.5s var(--signature) both;\n  transform-origin: left;\n}\n@keyframes souligne { from { transform: scaleX(0); } }\n.filtres { display: flex; gap: 8px; overflow: hidden; }\n\n/* La mosaique : deux colonnes au telephone, trois a la tablette. */\n/* Fidele a Pinterest : a plat, 5 px d ecart et de bord, rayon 12, le vrai\n   format de chaque photo ; dessous, qui l a prise et avec quel telephone. */\n.mosaique {\n  columns: 2;\n  column-gap: 5px;\n  padding: 4px 5px calc(var(--haut-onglets) + 40px);\n}\n@media (min-width: 600px) { .mosaique { columns: 3; column-gap: 5px; } }\n.carte {\n  break-inside: avoid;\n  margin: 0 0 10px;\n  animation: carte 1.4s calc(0.35s + var(--n, 0) * 0.07s) var(--signature) both;\n}\n.carte-image {\n  position: relative;\n  border-radius: 12px;\n  overflow: hidden;\n  contain: layout paint;\n}\n.carte-image .photo { border-radius: inherit; }\n.duree, .son {\n  position: absolute;\n  top: 9px;\n  display: inline-flex;\n  align-items: center;\n  height: 24px;\n  padding: 0 8px;\n  border-radius: 999px;\n  color: #fff;\n  font-size: 12px;\n  font-weight: 600;\n  /* Fond plein, sans flou : il y en a une par carte, et chaque flou se\n     recalcule a chaque image du defilement. */\n  background: hsl(229 30% 8% / 0.55);\n}\n.duree { left: 9px; }\n.son { right: 9px; width: 24px; padding: 0; justify-content: center; }\n.son .ic { width: 15px; height: 15px; }\n/* Le badge verifie : l icone seule, dans sa pastille lime. */\n.carte-image .badge { position: absolute; left: 8px; bottom: 8px; width: 26px; height: 26px; padding: 0; justify-content: center; font-size: 0; }\n.carte-image .badge .ic { width: 16px; height: 16px; margin: 0; }\n.carte-pied {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 6px;\n  padding: 7px 2px 0 4px;\n}\n.carte-lieu { font-size: 13.5px; font-weight: 600; line-height: 1.25; }\n.carte-appareil { display: flex; align-items: center; gap: 3px; margin-top: 2px; font-size: 12px; color: var(--discret); }\n.carte-pied .ic { color: var(--discret); }\n\n/* ------------------------------------------------------------ E05 photo */\n.photo-page { padding-bottom: calc(var(--haut-onglets) + 40px); }\n.photo-grande {\n  position: relative;\n  margin: 0 8px;\n  border-radius: 30px;\n  overflow: hidden;\n  animation: carte 1.3s 0.1s var(--signature) both;\n}\n.photo-grande .photo { border-radius: inherit; }\n.photo-grande .commandes {\n  position: absolute;\n  top: 12px; left: 12px; right: 12px;\n  display: flex;\n  justify-content: space-between;\n}\n/* Pas de badge sur la grande photo : il est dans la fiche de capture. */\n.photo-grande .badge { display: none; }\n/* Les boutons poses sur la photo : du verre liquide transparent. */\n.photo-grande .rond-verre { background: transparent; box-shadow: inset 0 1px 0.5px hsl(0 0% 100% / 0.9), inset 0 -1px 0.5px hsl(0 0% 100% / 0.5), 0 0 0 0.5px hsl(0 0% 100% / 0.35); color: #121212; }\n\n.actions-photo {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  padding: 12px calc(var(--marge-app) - 6px) 4px;\n  animation: monte 0.9s 0.45s var(--signature) both;\n}\n.action {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  height: 44px;\n  padding: 0 8px;\n  border: none;\n  background: none;\n  font-weight: 600;\n  font-size: 14px;\n}\n.action.aime { color: var(--erreur); }\n.action.aime .ic { fill: currentColor; }\n.actions-photo .espace { flex: 1; }\n.bouton-verre.plein .ic { stroke-width: 2; }\n.bouton-verre .bouton-verre-texte .ic { width: 19px; height: 19px; }\n\n.photo-texte { padding: 6px var(--marge-app) 0; }\n.photo-titre { margin: 4px 0 6px; font-size: 24px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; }\n.photo-legende { margin: 0 0 16px; color: hsl(229 12% 28%); animation: monte 0.9s 0.6s var(--signature) both; }\n\n/* La fiche de capture : ce qui rend le contenu verifiable. */\n.fiche {\n  margin: 0 var(--marge-app) 16px;\n  padding: 14px 16px 6px;\n  border-radius: 22px;\n  animation: monte 1s 0.7s var(--signature) both;\n}\n.fiche-tete { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }\n.fiche-tete h3 { margin: 0; font-size: 15px; font-weight: 600; }\n.fiche dl { margin: 0; }\n.fiche-ligne {\n  display: grid;\n  grid-template-columns: 28px 1fr;\n  align-items: start;\n  gap: 4px 8px;\n  padding: 10px 0;\n  border-top: 1px solid hsl(229 30% 30% / 0.08);\n}\n.fiche-ligne:first-child { border-top: none; }\n.fiche-ligne .ic { color: var(--texte); margin-top: 1px; }\n.fiche-ligne dt { font-size: 12px; color: var(--discret); }\n.fiche-ligne dd { margin: 1px 0 0; font-weight: 600; }\n.fiche-ligne .origine { display: block; font-weight: 400; font-size: 12px; color: var(--discret); }\n\n.createur {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  margin: 0 var(--marge-app) 18px;\n  animation: monte 1s 0.8s var(--signature) both;\n}\n.createur-nom { font-weight: 600; }\n.createur-sous { font-size: 13px; color: var(--discret); }\n.createur .bouton-verre { margin-left: auto; min-height: 42px; }\n\n.commentaires { margin: 0 var(--marge-app) 20px; animation: monte 1s 0.9s var(--signature) both; }\n.commentaires h3 { margin: 0 0 10px; font-size: 16px; }\n.commentaire { display: flex; gap: 10px; margin-bottom: 12px; font-size: 14px; }\n.commentaire b { font-weight: 600; }\n.commentaire .epingle { display: block; margin-bottom: 2px; font-size: 11.5px; color: var(--ocean); font-weight: 600; }\n.saisie-commentaire {\n  display: flex;\n  align-items: center;\n  height: 48px;\n  padding: 0 16px;\n  border-radius: 999px;\n  color: var(--discret);\n  font-size: 14px;\n}\n\n.suite-titre { margin: 8px var(--marge-app) 12px; font-size: 18px; font-weight: 700; }\n\n/* A la tablette : la photo a gauche, le reste a droite. */\n@media (min-width: 600px) {\n  .photo-page .colonnes {\n    display: grid;\n    grid-template-columns: 1.05fr 1fr;\n    gap: 6px;\n    align-items: start;\n    padding: 0 12px;\n  }\n  .photo-grande { margin: 0; position: sticky; top: 8px; }\n  .photo-page .colonne-infos { padding-top: 4px; }\n  .photo-page .mosaique { columns: 3; }\n}\n\n/* ------------------------------------------------------------ E06 reels */\n.reels { position: relative; height: 100vh; overflow: hidden; background: #000; color: #fff; }\n.reel-video {\n  position: absolute;\n  inset: 0;\n  height: 100%;\n  background-size: cover;\n  background-position: center;\n  animation: fondu 1.2s var(--interface) both;\n}\n.reels::before, .reels::after {\n  content: '';\n  position: absolute;\n  left: 0; right: 0;\n  z-index: 1;\n  pointer-events: none;\n}\n.reels::before { top: 0; height: 180px; background: linear-gradient(180deg, hsl(229 40% 5% / 0.55), transparent); }\n.reels::after { bottom: 0; height: 60%; background: linear-gradient(0deg, hsl(229 40% 4% / 0.88) 22%, hsl(229 40% 4% / 0.45) 60%, transparent); }\n.reels .barre-etat, .reels .reels-haut { position: relative; z-index: 2; }\n.reels .barre-etat { color: #fff; }\n.reels-haut {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 2px var(--marge-app) 0;\n}\n/* Les flux a gauche, la loupe seule a droite : jamais l un sur l autre. */\n.reels-flux { display: flex; flex: 1; min-width: 0; gap: 18px; font-weight: 600; font-size: 16px; white-space: nowrap; color: hsl(0 0% 100% / 0.7); }\n.reels-haut > .rond-verre { flex: none; margin-left: auto; }\n.reels-flux span[aria-current='true'] { color: #fff; position: relative; }\n.reels-flux span[aria-current='true']::after {\n  content: '';\n  position: absolute;\n  left: 25%; right: 25%; bottom: -6px;\n  height: 3px;\n  border-radius: 3px;\n  background: #fff;\n}\n.reels .rond-verre { color: #fff; }\n.reels .verre { color: #fff; }\n\n.reels-cote {\n  position: absolute;\n  z-index: 3;\n  right: 10px;\n  bottom: calc(var(--haut-onglets) + 26px);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 14px;\n}\n.reels-cote .bouton-reel {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 3px;\n  font-size: 12px;\n  font-weight: 600;\n  animation: monte 0.9s calc(0.4s + var(--k) * 0.07s) var(--signature) both;\n}\n.reels-cote .rond-verre { width: 48px; height: 48px; }\n.reels-cote .aime .ic { fill: var(--erreur); stroke: var(--erreur); }\n.reels-cote .avatar { width: 46px; height: 46px; box-shadow: 0 0 0 2px #fff; }\n.reels-cote .suivre {\n  position: absolute;\n  bottom: -9px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 20px;\n  height: 20px;\n  border-radius: 50%;\n  background: var(--ocean);\n  color: #fff;\n}\n.reels-cote .suivre .ic { width: 14px; height: 14px; stroke-width: 2.2; }\n.reels-cote .profil-reel { position: relative; display: flex; justify-content: center; margin-bottom: 6px; }\n/* Le disque du son tourne pendant la lecture (transform seul). */\n.disque-son {\n  width: 42px;\n  height: 42px;\n  border: 7px solid #17191f;\n  border-radius: 50%;\n  background-size: cover;\n  background-position: center;\n  box-shadow: 0 0 0 1px hsl(0 0% 100% / 0.12);\n  animation: monte 0.9s calc(0.4s + var(--k) * 0.07s) var(--signature) both, disque 6s 1.3s linear infinite;\n}\n@keyframes disque { to { rotate: 1turn; } }\n@media (prefers-reduced-motion: reduce) { .disque-son { animation: none; } }\n\n.reels-bas {\n  position: absolute;\n  z-index: 3;\n  left: var(--marge-app);\n  right: 84px;\n  bottom: calc(var(--haut-onglets) + 26px);\n}\n.reels-bas .createur-ligne { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; animation: monte 0.9s 0.5s var(--signature) both; }\n.reels-bas .createur-ligne b { font-size: 15px; }\n.reels-bas .suivre-texte {\n  height: 30px;\n  padding: 0 12px;\n  border-radius: 10px;\n  border: 1px solid hsl(0 0% 100% / 0.6);\n  background: none;\n  color: #fff;\n  font-size: 13px;\n  font-weight: 600;\n}\n.reels-bas p { margin: 0 0 10px; font-size: 14.5px; line-height: 1.4; animation: monte 0.9s 0.6s var(--signature) both; }\n.reels-bas .infos-capture {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  margin-bottom: 10px;\n  animation: monte 0.9s 0.7s var(--signature) both;\n}\n.reels-bas .info {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  height: 26px;\n  padding: 0 10px 0 8px;\n  border-radius: 999px;\n  font-size: 12px;\n  font-weight: 600;\n  background: hsl(0 0% 0% / 0.38);\n}\n.reels-bas .info .ic { width: 16px; height: 16px; }\n.reels-bas .y-aller { min-height: 46px; animation: monte 0.9s 0.8s var(--signature) both; }\n.reels-son { display: flex; align-items: center; gap: 6px; margin-top: 10px; font-size: 12.5px; color: hsl(0 0% 100% / 0.85); }\n.reels-progres {\n  position: absolute;\n  z-index: 3;\n  left: var(--marge-app);\n  right: var(--marge-app);\n  bottom: calc(var(--haut-onglets) + 19px);\n  height: 2.5px;\n  border-radius: 3px;\n  background: hsl(0 0% 100% / 0.25);\n  overflow: hidden;\n}\n.reels-progres::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  width: 38%;\n  border-radius: inherit;\n  background: #fff;\n}\n\n@media (min-width: 600px) {\n  .reels-bas { right: 120px; max-width: 520px; }\n  .reels-cote { right: 22px; }\n}\n\n/* ------------------------------------------------------------ E31 recherche */\n.recherche { padding: 0 var(--marge-app) calc(var(--haut-onglets) + 40px); }\n.champ-recherche {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  height: 50px;\n  margin: 6px 0 16px;\n  padding: 0 16px;\n  border-radius: 999px;\n  color: var(--discret);\n  font-size: 15px;\n  animation: monte 0.9s 0.1s var(--signature) both;\n}\n.champ-recherche .curseur { width: 1.5px; height: 20px; margin-left: -6px; background: var(--ocean); animation: clignote 1s steps(1) infinite; }\n@keyframes clignote { 50% { opacity: 0; } }\n.recentes { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }\n.recentes .pastille { animation: monte 0.8s calc(0.2s + var(--k) * 0.05s) var(--signature) both; }\n.recentes .pastille .ic { color: var(--discret); }\n.section-titre {\n  margin: 0 0 12px;\n  font-size: 19px;\n  font-weight: 700;\n  letter-spacing: -0.01em;\n  text-align: center;\n}\n.idees {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 8px;\n  margin-bottom: 22px;\n}\n@media (min-width: 600px) { .idees { grid-template-columns: repeat(3, 1fr); gap: 12px; } }\n.idee {\n  position: relative;\n  height: 92px;\n  border-radius: 16px;\n  overflow: hidden;\n  animation: carte 1.2s calc(0.3s + var(--n) * 0.06s) var(--signature) both;\n}\n@media (min-width: 600px) { .idee { height: 120px; } }\n.idee .photo { position: absolute; inset: 0; aspect-ratio: auto !important; height: 100%; }\n.idee::after { content: ''; position: absolute; inset: 0; background: hsl(229 40% 8% / 0.38); }\n.idee span {\n  position: absolute;\n  z-index: 1;\n  inset: 0;\n  display: grid;\n  place-items: center;\n  padding: 8px;\n  text-align: center;\n  color: #fff;\n  font-weight: 600;\n  font-size: 15px;\n  line-height: 1.2;\n  text-shadow: 0 1px 8px hsl(0 0% 0% / 0.35);\n}\n\n/* ---- styles/compte.css ---- */\n/* USW : les ecrans du compte. Bienvenue (E01), inscription et connexion\n   (E02), conditions generales (E34), aide (E35). Le champ est celui de\n   SafeVault, tel quel : une lame de verre, le libelle au-dessus, une ligne\n   d aide dessous. Les elements entrent un a un (--k). */\n\n/* ------------------------------------------------------------ la page simple */\n.page {\n  display: flex;\n  flex-direction: column;\n  min-height: 100vh;\n  padding: 0 var(--marge-app) 28px;\n}\n.page > .barre-etat,\n.bienvenue > .barre-etat { margin-inline: calc(50% - 50vw); }\n@media (min-width: 600px) {\n  .page { padding-inline: max(var(--marge-app), calc((100% - 520px) / 2)); }\n  .page.lecture { padding-inline: max(var(--marge-app), calc((100% - 640px) / 2)); }\n}\n.page-haut { display: flex; align-items: center; gap: 12px; height: 60px; }\n.page-haut-titre { font-weight: 700; font-size: 17px; }\n.page-titre { margin: 10px 0 8px; font-size: 30px; font-weight: 700; letter-spacing: -0.03em; line-height: 1.08; }\n.page-texte { margin: 0 0 26px; color: var(--discret); font-size: 15.5px; line-height: 1.45; animation: monte 0.9s 0.35s var(--signature) both; }\n.page-texte b { color: var(--texte); font-weight: 600; }\n.pied-page { margin: auto 0 0; padding-top: 28px; text-align: center; color: var(--discret); font-size: 14.5px; }\n.lien { color: var(--ocean); font-weight: 600; text-decoration: none; cursor: pointer; }\n.lien.droite { justify-self: end; margin-top: -6px; font-size: 14px; }\n.lien-discret { border: none; background: none; padding: 8px 4px; color: var(--discret); font-weight: 600; font-size: 14.5px; cursor: pointer; }\n.lien-discret.centre { justify-self: center; }\n.large { width: 100%; }\n.bouton-verre .bouton-verre-texte .ic { width: 19px; height: 19px; }\n\n/* ------------------------------------------------------------ le formulaire */\n.formulaire { display: grid; gap: 18px; }\n.formulaire > * { animation: monte 0.8s calc(0.4s + var(--k, 0) * 0.06s) var(--signature) both; }\n.champ-bloc { display: flex; flex-direction: column; gap: 0.6rem; }\n.champ-libelle { font-weight: 600; font-size: 0.92rem; }\n.champ-aide { display: flex; align-items: center; gap: 6px; margin: 0; color: var(--discret); font-size: 0.82rem; line-height: 1.45; }\n.champ {\n  display: flex;\n  align-items: center;\n  gap: 0.65rem;\n  min-height: 3.2rem;\n  padding: 0.95rem 1.05rem;\n  border-radius: 14px;\n  outline: 2px solid transparent;\n  transition: outline-color 0.2s var(--courbe);\n}\n.champ.focus { outline-color: var(--ocean); }\n.champ > .ic { width: 1.15rem; height: 1.15rem; color: var(--discret); }\n.champ-valeur, .champ-place { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }\n.champ-place { color: var(--discret); }\n.champ .curseur { flex: none; width: 1.5px; height: 20px; margin-left: -8px; background: var(--ocean); animation: clignote 1s steps(1) infinite; }\n.champ .curseur + .champ-place { margin-left: -8px; }\n.page .section-titre { text-align: left; }\n.champ > .ic:first-child + * { flex: 0 1 auto; }\n.champ > :last-child:is(.ic, .champ-bouton) { margin-left: auto; }\n.champ .ic.ok, .champ-aide .ic.mini { color: hsl(140 55% 36%); }\n.champ .ic.ok { width: 1.15rem; height: 1.15rem; stroke-width: 2; }\n.champ-bouton { display: inline-flex; border: none; background: none; padding: 0; color: var(--discret); cursor: pointer; }\n.champ-bouton .ic { width: 1.25rem; height: 1.25rem; }\n/* La solidite du mot de passe : quatre traits, trois remplis. */\n.force { display: inline-grid; grid-template-columns: repeat(4, 16px); gap: 3px; margin-right: 4px; }\n.force i { height: 4px; border-radius: 2px; background: var(--ocean); }\n.force i:last-child { background: hsl(229 30% 30% / 0.15); }\n.case-ligne { display: flex; align-items: flex-start; gap: 12px; font-size: 14px; line-height: 1.45; color: var(--discret); }\n.case { display: grid; flex: none; place-items: center; width: 22px; height: 22px; border-radius: 7px; background: var(--ocean); color: #fff; }\n.case .ic { width: 16px; height: 16px; stroke-width: 2.2; }\n.criteres { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; font-size: 14px; color: var(--discret); }\n.criteres li { display: flex; align-items: center; gap: 8px; }\n.criteres .ic { width: 18px; height: 18px; padding: 2px; border-radius: 50%; background: hsl(229 30% 30% / 0.1); color: transparent; stroke-width: 2.4; }\n.criteres li.ok { color: var(--texte); }\n.criteres li.ok .ic { background: hsl(140 55% 40%); color: #fff; }\n\n/* Le code a six chiffres. */\n.code { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; margin-bottom: 14px; }\n.code > span {\n  display: grid;\n  place-items: center;\n  height: 60px;\n  border-radius: 14px;\n  font-size: 24px;\n  font-weight: 700;\n  outline: 2px solid transparent;\n  animation: monte 0.7s calc(0.4s + var(--k) * 0.05s) var(--signature) both;\n}\n.code > span.actif { outline-color: var(--ocean); }\n.code .curseur { width: 1.5px; height: 26px; background: var(--ocean); animation: clignote 1s steps(1) infinite; }\n.renvoi { margin-bottom: 22px; }\n\n/* ------------------------------------------------------------ E01 bienvenue */\n.bienvenue { display: flex; flex-direction: column; padding: 0 var(--marge-app) 28px; }\n@media (min-width: 600px) { .bienvenue { padding-inline: max(var(--marge-app), calc((100% - 520px) / 2)); } }\n/* Trois traits : celui de l ecran se remplit en 6 s, puis l ecran suivant vient. */\n.progression { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-top: 8px; }\n.progression span { position: relative; height: 3px; overflow: hidden; border-radius: 3px; background: hsl(229 30% 30% / 0.14); }\n.progression span.fait::after,\n.progression span.encours::after { content: ''; position: absolute; inset: 0; background: var(--texte); transform-origin: left; }\n.progression span.encours::after { animation: remplit 6s 0.3s linear both; }\n@keyframes remplit { from { transform: scaleX(0); } }\n.bienvenue-haut { display: flex; justify-content: flex-end; height: 44px; }\n.bienvenue-visuel { display: grid; flex: 1; min-height: 0; place-items: center; }\n.bienvenue-texte .page-texte { margin-bottom: 0; }\n.bienvenue-actions { display: grid; gap: 10px; margin-top: 26px; }\n.bienvenue-actions > * { animation: monte 0.8s calc(0.55s + var(--k, 0) * 0.06s) var(--signature) both; }\n\n/* 1 : la pile de l accueil, en grand. */\n.pile-grande { width: min(64%, 300px); aspect-ratio: 4 / 5; margin-top: 18px; }\n.pile-grande .pile-carte { border-radius: 26px; }\n/* 2 et 3 : une photo, et ce qu elle dit. */\n.demo-photo {\n  position: relative;\n  width: min(72%, 320px);\n  aspect-ratio: 4 / 5;\n  overflow: hidden;\n  border-radius: 26px;\n  box-shadow: 0 24px 48px -30px hsl(229 50% 20% / 0.55);\n  animation: carte 1.2s 0.15s var(--signature) both;\n}\n.demo-photo .photo { height: 100%; aspect-ratio: auto; }\n.demo-photo .badge { position: absolute; top: 12px; left: 12px; }\n.puces { position: absolute; left: 12px; right: 12px; bottom: 12px; display: grid; justify-items: start; gap: 6px; }\n.puce {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  height: 34px;\n  padding: 0 12px 0 9px;\n  border-radius: 999px;\n  background: hsl(0 0% 100% / 0.9);\n  font-size: 13px;\n  font-weight: 600;\n  white-space: nowrap;\n  animation: monte 0.8s calc(0.7s + var(--k) * 0.12s) var(--signature) both;\n}\n.puce .ic { width: 18px; height: 18px; }\n/* Le repere tombe sur la photo avec un leger rebond. */\n.repere-demo { position: absolute; left: 50%; top: 34%; translate: -50% -50%; animation: repere-tombe 0.9s 0.6s cubic-bezier(0.2, 1.3, 0.35, 1) both; }\n.repere-demo .ic { width: 64px; height: 64px; }\n@keyframes repere-tombe { from { transform: translateY(-60px); opacity: 0; } 30% { opacity: 1; } }\n.demo-aller { position: absolute; left: 50%; bottom: 16px; translate: -50% 0; min-height: 46px; animation: monte 0.8s 0.9s var(--signature) both; }\n\n/* ------------------------------------------------------------ E34 lecture */\n.document-tete .page-titre { font-size: 28px; }\n/* Le document vivant de SafeVault, tel quel (pieces/DocumentVivant.css). */\n.document-vivant {\n  flex: none;\n  width: 2.75rem;\n  height: 3.3rem;\n  margin: 6px 0 4px 2px;\n  overflow: visible;\n  transform: rotate(-4deg);\n  filter: drop-shadow(0 1px 1px hsl(229 40% 20% / 0.14)) drop-shadow(0 8px 12px hsl(229 40% 25% / 0.22));\n}\n.document-vivant .papier,\n.document-vivant .papier-pli { stroke: hsl(229 25% 60% / 0.55); stroke-width: 0.75; stroke-linejoin: round; }\n.document-vivant .ligne {\n  fill: none;\n  stroke: hsl(229 20% 30% / 0.7);\n  stroke-width: 1.3;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-dasharray: 1;\n  stroke-dashoffset: 1;\n  animation: 11s var(--courbe) infinite both;\n}\n.document-vivant .ligne-1 { stroke: var(--ocean); stroke-width: 1.9; animation-name: ecrire-1; }\n.document-vivant .ligne-2 { animation-name: ecrire-2; }\n.document-vivant .ligne-3 { animation-name: ecrire-3; }\n.document-vivant .ligne-4 { animation-name: ecrire-4; }\n.document-vivant .ligne-5 { animation-name: ecrire-5; }\n@keyframes ecrire-1 { 0%, 4% { stroke-dashoffset: 1; opacity: 1; } 13%, 76% { stroke-dashoffset: 0; opacity: 1; } 84%, 96% { stroke-dashoffset: 0; opacity: 0; } 97%, 100% { stroke-dashoffset: 1; opacity: 0; } }\n@keyframes ecrire-2 { 0%, 15% { stroke-dashoffset: 1; opacity: 1; } 27%, 76% { stroke-dashoffset: 0; opacity: 1; } 84%, 96% { stroke-dashoffset: 0; opacity: 0; } 97%, 100% { stroke-dashoffset: 1; opacity: 0; } }\n@keyframes ecrire-3 { 0%, 29% { stroke-dashoffset: 1; opacity: 1; } 40%, 76% { stroke-dashoffset: 0; opacity: 1; } 84%, 96% { stroke-dashoffset: 0; opacity: 0; } 97%, 100% { stroke-dashoffset: 1; opacity: 0; } }\n@keyframes ecrire-4 { 0%, 42% { stroke-dashoffset: 1; opacity: 1; } 54%, 76% { stroke-dashoffset: 0; opacity: 1; } 84%, 96% { stroke-dashoffset: 0; opacity: 0; } 97%, 100% { stroke-dashoffset: 1; opacity: 0; } }\n@keyframes ecrire-5 { 0%, 56% { stroke-dashoffset: 1; opacity: 1; } 63%, 76% { stroke-dashoffset: 0; opacity: 1; } 84%, 96% { stroke-dashoffset: 0; opacity: 0; } 97%, 100% { stroke-dashoffset: 1; opacity: 0; } }\n@media (prefers-reduced-motion: reduce) { .document-vivant .ligne { animation: none; stroke-dashoffset: 0; } }\n.sommaire { display: flex; gap: 8px; margin: 0 calc(-1 * var(--marge-app)) 22px; padding: 0 var(--marge-app); overflow: hidden; }\n.sommaire .pastille { animation: monte 0.8s calc(0.4s + var(--k) * 0.04s) var(--signature) both; }\n.document { display: grid; gap: 22px; }\n.article { animation: monte 0.9s calc(0.45s + var(--n) * 0.05s) var(--signature) both; }\n.article h2 { display: flex; align-items: center; gap: 10px; margin: 0 0 8px; font-size: 17.5px; font-weight: 700; letter-spacing: -0.01em; }\n.article .numero { display: inline-grid; flex: none; place-items: center; width: 26px; height: 26px; border-radius: 8px; background: var(--texte); color: #fff; font-size: 13px; }\n.article p { margin: 0; color: hsl(229 20% 28%); font-size: 15px; line-height: 1.6; }\n\n/* ------------------------------------------------------------ E35 aide */\n.recherche-aide { margin-bottom: 26px; animation: monte 0.8s 0.35s var(--signature) both; }\n.sujets { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 28px; }\n@media (min-width: 600px) { .sujets { grid-template-columns: repeat(3, 1fr); } }\n.sujet {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 18px;\n  padding: 14px;\n  border: none;\n  border-radius: 18px;\n  text-align: left;\n  font-weight: 600;\n  font-size: 14.5px;\n  cursor: pointer;\n  animation: monte 0.8s calc(0.4s + var(--n) * 0.05s) var(--signature) both;\n}\n.sujet .ic { width: 26px; height: 26px; color: var(--texte); }\n.questions { display: grid; gap: 8px; margin-bottom: 26px; }\n.question { border-radius: 16px; background: hsl(0 0% 100% / 0.55); animation: monte 0.8s calc(0.5s + var(--n) * 0.05s) var(--signature) both; }\n.question button { display: flex; align-items: center; justify-content: space-between; gap: 12px; width: 100%; padding: 15px 16px; border: none; background: none; text-align: left; font-weight: 600; font-size: 14.5px; cursor: pointer; }\n.question .ic { flex: none; color: var(--discret); transition: transform 0.35s var(--interface); }\n.question.ouverte .ic { transform: rotate(180deg); }\n.question p { margin: -4px 16px 0; padding-bottom: 16px; color: var(--discret); font-size: 14.5px; line-height: 1.55; }\n.contact { display: flex; align-items: center; gap: 14px; padding: 16px; border-radius: 20px; margin-bottom: 18px; }\n.contact > div { display: grid; flex: 1; gap: 2px; font-size: 14px; color: var(--discret); }\n.contact strong { color: var(--texte); font-size: 15px; }\n.contact-icone { display: grid; flex: none; place-items: center; width: 44px; height: 44px; border-radius: 14px; background: hsl(0 0% 100% / 0.7); color: var(--texte); }\n.contact .bouton-verre { min-height: 42px; }\n.liens-legaux { display: grid; }\n.liens-legaux a { display: flex; align-items: center; gap: 12px; padding: 14px 2px; border-top: 1px solid hsl(229 30% 30% / 0.1); font-weight: 600; font-size: 14.5px; cursor: pointer; }\n.liens-legaux a .ic:first-child { color: var(--discret); }\n.liens-legaux a .ic:last-child { margin-left: auto; color: var(--discret); }\n\n/* ------------------------------------------------------------ E02 l entree */\n/* Comme celle de Pinterest : en haut, des colonnes de photos qui glissent\n   lentement en sens contraires (transform seulement, sans fin) ; dessous, le\n   nom, un champ e-mail et « Continuer », ou Google. */\n.entree { display: flex; flex-direction: column; }\n.entree > .barre-etat { position: absolute; top: 0; left: 0; right: 0; z-index: 5; }\n.entree-mosaique {\n  position: relative;\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 8px;\n  height: 42vh;\n  padding: 0 8px;\n  overflow: hidden;\n  -webkit-mask-image: linear-gradient(#000 40%, #0000 94%);\n  mask-image: linear-gradient(#000 40%, #0000 94%);\n}\n@media (min-width: 600px) { .entree-mosaique { grid-template-columns: repeat(5, 1fr); height: 46vh; } }\n.entree-mosaique .colonne { display: grid; gap: 8px; align-content: start; animation: glisse 48s linear infinite; }\n.entree-mosaique .colonne:nth-child(even) { margin-top: -40%; animation-direction: reverse; }\n.entree-mosaique .colonne:nth-child(n + 4) { display: none; }\n@media (min-width: 600px) { .entree-mosaique .colonne:nth-child(n + 4) { display: grid; } }\n.entree-mosaique .photo { aspect-ratio: 3 / 4; border-radius: 16px; }\n@keyframes glisse { to { transform: translateY(-50%); } }\n.entree-corps { position: relative; display: flex; flex: 1; flex-direction: column; align-items: center; margin-top: -3vh; padding: 0 var(--marge-app) 24px; text-align: center; }\n@media (min-width: 600px) { .entree-corps { width: 520px; align-self: center; } }\n.entree-corps .formulaire { width: 100%; text-align: left; }\n.entree-corps .page-titre { margin-bottom: 22px; }\n/* Le sigle de l ouverture, en petit : U et S en ocean, W en limonade. */\n.logo-usw { display: inline-flex; gap: 1px; font-size: 40px; font-weight: 700; letter-spacing: -0.04em; line-height: 1; color: var(--ocean); animation: monte 0.8s 0.15s var(--signature) both; }\n.logo-usw .citron { color: var(--limonade); }\n.separateur { display: flex; align-items: center; gap: 12px; color: var(--discret); font-size: 13.5px; }\n.separateur::before, .separateur::after { content: ''; flex: 1; height: 1px; background: hsl(229 30% 30% / 0.14); }\n.bouton-google .ic { width: 20px; height: 20px; }\n.legal { margin: 0; color: var(--discret); font-size: 12.5px; line-height: 1.5; text-align: center; }\n.pied-page.legal { font-size: 12.5px; }\n\n/* Bon retour : le compte reconnu. */\n.retour-compte { display: grid; justify-items: start; }\n.avatar.grand { width: 64px; height: 64px; font-size: 22px; margin-top: 4px; animation: monte 0.8s 0.15s var(--signature) both; }\n.avatar.geant { position: relative; width: 104px; height: 104px; font-size: 34px; }\n\n/* ------------------------------------------------------------ E36 completer le profil */\n.completer .progression { margin-top: 8px; }\n.etape { flex: 1; color: var(--discret); font-size: 14px; font-weight: 600; }\n.photo-profil { display: grid; justify-items: center; gap: 10px; margin-bottom: 22px; animation: monte 0.8s 0.3s var(--signature) both; }\n.photo-profil-bouton { position: absolute; right: -2px; bottom: -2px; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--texte); color: #fff; box-shadow: 0 0 0 3px var(--fond); }\n.photo-profil-bouton .ic { width: 18px; height: 18px; }\n.facultatif { margin-left: 4px; color: var(--discret); font-weight: 400; font-size: 0.82rem; }\n.champ.zone { align-items: flex-start; min-height: 5.5rem; }\n/* Un reglage en carte : icone, texte, interrupteur. */\n.reglage-carte { display: flex; align-items: center; gap: 14px; padding: 14px 16px; border-radius: 18px; }\n.reglage-carte > div { display: grid; flex: 1; gap: 2px; font-size: 13.5px; color: var(--discret); line-height: 1.4; }\n.reglage-carte strong { color: var(--texte); font-size: 15px; }\n.reglage-icone { display: grid; flex: none; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: hsl(0 0% 100% / 0.7); }\n/* L interrupteur, comme celui d iOS : l ocean quand il est ouvert. */\n.interrupteur { position: relative; flex: none; width: 50px; height: 30px; border-radius: 999px; background: hsl(229 30% 30% / 0.18); transition: background 0.3s var(--interface); }\n.interrupteur::after { content: ''; position: absolute; top: 3px; left: 3px; width: 24px; height: 24px; border-radius: 50%; background: #fff; box-shadow: 0 2px 6px hsl(229 50% 20% / 0.25); transition: transform 0.35s var(--ressort); }\n.interrupteur.actif { background: var(--ocean); }\n.interrupteur.actif::after { transform: translateX(20px); }\n/* Les types de lieux : des tuiles photo, cochees a l encre. */\n.interets { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; padding-bottom: 96px; }\n.interet {\n  position: relative;\n  display: block;\n  padding: 0;\n  overflow: hidden;\n  border: none;\n  border-radius: 16px;\n  aspect-ratio: 3 / 4;\n  background: none;\n  cursor: pointer;\n  animation: carte 1s calc(0.35s + var(--n) * 0.05s) var(--signature) both;\n}\n.interet .photo { position: absolute; inset: 0; height: 100%; aspect-ratio: auto; transition: transform 0.5s var(--interface); }\n.interet::after { content: ''; position: absolute; inset: 0; background: linear-gradient(transparent 45%, hsl(229 40% 8% / 0.62)); }\n.interet-nom { position: absolute; z-index: 1; left: 10px; right: 10px; bottom: 9px; color: #fff; font-size: 13.5px; font-weight: 700; text-align: left; line-height: 1.2; }\n.interet.choisi { box-shadow: 0 0 0 3px var(--fond), 0 0 0 5px var(--texte); }\n.interet.choisi .photo { transform: scale(0.94); border-radius: 12px; }\n.interet-coche { position: absolute; z-index: 1; top: 8px; right: 8px; display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--texte); color: #fff; }\n.interet-coche .ic { width: 16px; height: 16px; stroke-width: 2.4; }\n.completer-bas { position: fixed; left: 0; right: 0; bottom: 0; padding: 14px var(--marge-app) 22px; }\n.completer-bas::before { content: ''; position: absolute; inset: -24px 0 0; z-index: -1; background: hsl(229 36% 92% / 0.85); -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px); -webkit-mask-image: linear-gradient(#0000, #000 35%); mask-image: linear-gradient(#0000, #000 35%); }\n@media (min-width: 600px) { .completer-bas { padding-inline: calc((100% - 520px) / 2); } .interets { grid-template-columns: repeat(4, 1fr); } }\n\n/* ------------------------------------------------------------ les pages du parcours e-mail */\n/* Mot de passe, code, oubli : l en-tete est centre (avatar, titre, texte) et\n   le bloc se pose au milieu de l ecran, un peu au-dessus, au lieu de rester\n   colle en haut. Le pied de page (mentions, « La corriger ») reste en bas. */\n.authentification { padding-bottom: max(28px, 7vh); }\n.authentification > .page-haut + * { margin-top: auto; }\n.authentification > .formulaire { margin-bottom: auto; }\n.authentification > .pied-page { padding-top: 20px; }\n.authentification .retour-compte { justify-items: center; text-align: center; }\n.authentification .page-titre, .authentification .page-texte { text-align: center; }\n.authentification .page-titre.mots { justify-content: center; }\n.authentification .code-cases { justify-content: center; }\n.authentification .renvoi { justify-content: center; text-align: center; }\n/* L e-mail tape, rappele en haut de la page du mot de passe : sans nom ni photo du compte. */\n.email-tape { display: inline-flex; align-items: center; gap: 8px; margin-bottom: 6px; padding: 8px 14px 8px 12px; border-radius: 999px; background: hsl(0 0% 100% / 0.75); font-size: 14px; font-weight: 600; animation: monte 0.8s 0.15s var(--signature) both; }\n.email-tape .ic { width: 17px; height: 17px; color: var(--discret); }\n.email-tape .lien { margin-left: 4px; font-size: 13.5px; }\n\n/* ---- styles/profil.css ---- */\n/* USW : le profil. Mon profil (E18), profil d un createur (E20), modifier le\n   profil et reglages (E21), notifications (E17). Les couleurs de la charte :\n   l ocean pour ce qui se clique, la limonade pour ce qui est sur, le rouge\n   (--erreur) pour ce qui coupe ou retire : se deconnecter, bloquer, signaler,\n   supprimer, un contenu retire. Les icones restent a l encre. */\n\n.espace { flex: 1; }\n.page-haut .rond-verre + .rond-verre { margin-left: 2px; }\n.page-haut-titre.centre { flex: 1; text-align: center; }\n.bouton-verre.petit { min-height: 38px; padding: 0 14px; font-size: 14px; border-radius: 12px; }\n.lien-encre { color: var(--texte); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1.5px; cursor: pointer; }\n.champ-valeur.multi { white-space: normal; line-height: 1.45; }\n.danger { color: var(--erreur); }\n\n/* ------------------------------------------------------------ E18 / E20 le profil */\n.profil-page { padding-bottom: 0; }\n.profil-haut { display: flex; padding: 0 var(--marge-app); }\n.profil-tete { display: grid; justify-items: center; padding: 4px var(--marge-app) 6px; text-align: center; }\n.profil-tete .avatar { animation: monte 0.8s 0.1s var(--signature) both; }\n.profil-nom { margin: 14px 0 2px; font-size: 26px; font-weight: 700; letter-spacing: -0.03em; }\n.profil-pseudo { margin: 0; color: var(--discret); font-size: 14.5px; font-weight: 600; animation: monte 0.8s 0.3s var(--signature) both; }\n.profil-bio { max-width: 34ch; margin: 10px 0 6px; font-size: 15px; line-height: 1.45; animation: monte 0.8s 0.35s var(--signature) both; }\n.profil-lieu { display: inline-flex; align-items: center; gap: 4px; margin: 0 0 16px; color: var(--discret); font-size: 13.5px; font-weight: 600; animation: monte 0.8s 0.4s var(--signature) both; }\n.profil-lieu .ic { width: 16px; height: 16px; }\n.profil-chiffres { display: flex; gap: 28px; margin-bottom: 18px; animation: monte 0.8s 0.45s var(--signature) both; }\n.profil-chiffres div { display: grid; gap: 1px; }\n.profil-chiffres strong { font-size: 18px; font-weight: 700; }\n.profil-chiffres span { color: var(--discret); font-size: 12.5px; }\n.profil-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; width: min(100%, 420px); animation: monte 0.8s 0.5s var(--signature) both; }\n.profil-actions .bouton-verre { min-height: 44px; }\n.profil-flux { justify-content: center; margin: 18px var(--marge-app) 10px; }\n\n/* La feuille d options, ouverte depuis « ... » : elle monte du bas. */\n.feuille-fond { position: fixed; inset: 0; z-index: 50; background: hsl(229 40% 8% / 0.32); animation: fondu 0.4s 0.6s var(--interface) both; }\n.feuille {\n  position: fixed;\n  z-index: 51;\n  left: 8px;\n  right: 8px;\n  bottom: 8px;\n  display: grid;\n  padding: 8px 8px 12px;\n  border-radius: 28px;\n  background: hsl(229 40% 97%);\n  animation: feuille-monte 0.6s 0.65s var(--signature) both;\n}\n@media (min-width: 600px) { .feuille { left: 50%; right: auto; width: 440px; translate: -50% 0; } }\n@keyframes feuille-monte { from { transform: translateY(110%); } }\n.feuille-poignee { justify-self: center; width: 40px; height: 5px; margin: 2px 0 8px; border-radius: 3px; background: hsl(229 30% 30% / 0.2); }\n.feuille-ligne { display: flex; align-items: center; gap: 14px; padding: 15px 14px; border: none; border-radius: 16px; background: none; font-weight: 600; font-size: 15.5px; text-align: left; cursor: pointer; }\n.feuille-ligne + .feuille-ligne { border-top: 1px solid hsl(229 30% 30% / 0.08); }\n\n/* ------------------------------------------------------------ E21 reglages */\n.reglages .page-titre { margin-bottom: 18px; }\n.compte-carte { display: flex; align-items: center; gap: 14px; padding: 14px 16px; margin-bottom: 22px; border-radius: 20px; animation: monte 0.8s 0.3s var(--signature) both; }\n.compte-carte .avatar.grand { width: 52px; height: 52px; font-size: 18px; margin: 0; }\n.compte-carte > div { display: grid; flex: 1; gap: 2px; color: var(--discret); font-size: 13.5px; }\n.compte-carte strong { color: var(--texte); font-size: 16px; }\n.compte-carte > .ic { color: var(--discret); }\n.groupe { margin-bottom: 20px; animation: monte 0.8s calc(0.4s + var(--n) * 0.06s) var(--signature) both; }\n.groupe-titre { margin: 0 0 8px 4px; color: var(--texte); font-size: 15.5px; font-weight: 700; }\n.groupe-corps { border-radius: 20px; overflow: hidden; }\n.reglage-ligne { display: flex; align-items: center; gap: 14px; min-height: 56px; padding: 8px 16px; font-size: 15px; font-weight: 600; cursor: pointer; }\n.reglage-ligne + .reglage-ligne { border-top: 1px solid hsl(229 30% 30% / 0.08); }\n.reglage-ligne .reglage-icone { width: 34px; height: 34px; border-radius: 10px; }\n.reglage-ligne .reglage-icone .ic { width: 20px; height: 20px; }\n.reglage-texte { flex: 1; }\n.reglage-valeur { color: var(--discret); font-weight: 500; font-size: 14px; }\n.reglage-ligne > .ic:last-child { color: var(--discret); }\n/* Se deconnecter : le rouge de la charte, icone comprise. */\n.reglage-ligne.danger { color: var(--erreur); }\n.reglage-ligne.danger .reglage-icone { background: hsl(0 84% 60% / 0.1); }\n.supprimer { display: block; margin: 4px auto 0; padding: 10px; border: none; background: none; color: var(--erreur); font-size: 14.5px; font-weight: 600; cursor: pointer; }\n.version { margin: 18px 0 0; color: var(--discret); font-size: 12.5px; text-align: center; }\n\n/* ------------------------------------------------------------ E17 notifications */\n.notifications .page-titre { margin-bottom: 18px; }\n.notifications .groupe-titre { margin-top: 6px; }\n.notifs { display: grid; gap: 4px; margin-bottom: 18px; }\n.notif { display: flex; align-items: center; gap: 12px; padding: 10px; margin: 0 -10px; border-radius: 18px; animation: monte 0.8s calc(0.35s + var(--n) * 0.05s) var(--signature) both; }\n/* Pas encore lue : un fond de verre, sans point ni couleur. */\n.notif.nouvelle { background: hsl(0 0% 100% / 0.6); }\n.notif p { flex: 1; margin: 0; font-size: 14.5px; line-height: 1.4; }\n.notif p b { font-weight: 700; }\n.quand { margin-left: 6px; color: var(--discret); font-size: 13px; }\n.notif .avatar { width: 44px; height: 44px; }\n.vignette { flex: none; width: 46px; height: 58px; border-radius: 10px; aspect-ratio: auto; }\n.notif-icone { display: grid; flex: none; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: hsl(0 0% 100% / 0.75); }\n.notif-icone .ic { width: 22px; height: 22px; }\n.notif-icone.ok { background: var(--limonade); color: hsl(71 60% 14%); }\n.notif-icone.danger { background: hsl(0 84% 60% / 0.12); color: var(--erreur); }\n.notif .bouton-verre { min-height: 38px; padding: 0 14px; font-size: 14px; }\n.notif .lien-encre { flex: none; font-size: 13.5px; }\n\n/* ---- styles/creer.css ---- */\n/* USW : le parcours Creer. Autoriser la camera (E32), creer (E12), camera\n   USW et reel (E27), monter (E28), son (E29), lecture du fichier (E13),\n   details (E14), completer (E15), lieu (E30), envoi (E16), mes envois (E26).\n   La camera est noire, comme celle de Snapchat ; le rouge de la charte dit\n   l enregistrement en cours et ce qui supprime ou refuse. */\n\n.note { display: flex; align-items: flex-start; gap: 8px; margin: 0; color: var(--discret); font-size: 13.5px; line-height: 1.45; }\n.note .ic { flex: none; width: 18px; height: 18px; margin-top: 1px; color: var(--texte); }\n.bas-page { display: grid; gap: 6px; margin-top: auto; padding-top: 22px; }\n.place-bouton { width: 44px; }\n.petit-rond { width: 38px; height: 38px; }\n.petit-rond .ic { width: 18px; height: 18px; }\n.rond-verre.danger { color: var(--erreur); }\n\n/* ------------------------------------------------------------ E32 autoriser */\n.objectif { position: relative; display: grid; place-items: center; width: 84px; height: 84px; margin: 4px 0 6px; border-radius: 26px; background: var(--texte); color: #fff; animation: monte 0.8s 0.15s var(--signature) both; }\n.objectif .ic { width: 38px; height: 38px; stroke-width: 1.7; }\n.objectif-verre { position: absolute; inset: 8px; border-radius: 20px; box-shadow: inset 0 0 0 1px hsl(0 0% 100% / 0.16); }\n\n/* ------------------------------------------------------------ E12 creer */\n.fond-feuille { pointer-events: none; }\n.feuille-titre { margin: 0 0 6px 6px; font-size: 22px; font-weight: 700; letter-spacing: -0.02em; }\n.option-creer { display: flex; align-items: center; gap: 14px; width: 100%; padding: 12px 8px; border: none; border-radius: 18px; background: none; text-align: left; cursor: pointer; animation: monte 0.7s calc(0.8s + var(--n) * 0.06s) var(--signature) both; }\n.option-creer + .option-creer { border-top: 1px solid hsl(229 30% 30% / 0.08); }\n.option-icone { display: grid; flex: none; place-items: center; width: 52px; height: 52px; border-radius: 16px; background: hsl(0 0% 100% / 0.9); box-shadow: 0 6px 16px -10px hsl(229 50% 20% / 0.5); }\n.option-icone .ic { width: 26px; height: 26px; }\n.option-texte { display: grid; flex: 1; gap: 2px; font-size: 13.5px; color: var(--discret); }\n.option-texte strong { color: var(--texte); font-size: 16px; }\n.option-creer > .ic:last-child { color: var(--discret); }\n.rappel { margin: 10px 6px 0; padding: 12px 14px; border-radius: 16px; background: hsl(0 0% 100% / 0.6); }\n\n/* ------------------------------------------------------------ la camera USW */\n.camera { background: #000; color: #fff; }\n.camera .barre-etat { position: relative; z-index: 3; color: #fff; }\n.viseur { position: absolute; inset: 0; height: 100%; aspect-ratio: auto; }\n.camera .rond-verre.givre { color: var(--texte); }\n.camera-haut { position: absolute; z-index: 3; top: 42px; left: var(--marge-app); right: var(--marge-app); display: flex; align-items: center; gap: 8px; }\n/* Ce que la prise recevra d office : le telephone et la position. */\n.infos-prise { position: absolute; z-index: 3; top: 100px; left: 0; right: 0; display: flex; justify-content: center; gap: 6px; animation: monte 0.8s 0.4s var(--signature) both; }\n.info-prise { display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 12px 0 9px; border-radius: 999px; background: hsl(0 0% 0% / 0.5); font-size: 12.5px; font-weight: 600; }\n.info-prise .ic { width: 17px; height: 17px; }\n.camera-bas { position: absolute; z-index: 3; left: 0; right: 0; bottom: 26px; display: grid; gap: 16px; padding: 0 var(--marge-app); }\n.modes, .durees { display: flex; justify-content: center; gap: 22px; font-size: 14px; font-weight: 700; color: hsl(0 0% 100% / 0.62); }\n.modes [aria-current], .durees [aria-current] { color: #fff; }\n.durees span { padding: 6px 12px; border-radius: 999px; background: hsl(0 0% 0% / 0.45); }\n.durees [aria-current] { background: #fff; color: var(--texte); }\n.commandes-camera { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }\n.commandes-camera > :first-child { justify-self: start; }\n.commandes-camera > :last-child { justify-self: end; }\n.derniere { width: 48px; height: 48px; border-radius: 14px; box-shadow: 0 0 0 2px #fff; aspect-ratio: auto; }\n.declencheur { position: relative; width: 80px; height: 80px; padding: 0; border: 5px solid #fff; border-radius: 50%; background: none; cursor: pointer; }\n.declencheur::after { content: ''; position: absolute; inset: 5px; border-radius: 50%; background: #fff; transition: transform 0.3s var(--ressort); }\n.declencheur:active::after { transform: scale(0.88); }\n/* En train de filmer : le centre devient un carre rouge. */\n.declencheur.enregistre::after { inset: 21px; border-radius: 9px; background: var(--erreur); }\n.suivant-reel { min-height: 44px; padding: 0 16px; }\n.sequences { position: absolute; z-index: 4; top: 36px; left: var(--marge-app); right: var(--marge-app); display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; }\n.sequences span { position: relative; height: 4px; overflow: hidden; border-radius: 2px; background: hsl(0 0% 100% / 0.3); }\n.sequences span::after { content: ''; position: absolute; inset: 0; width: var(--p, 0%); background: #fff; }\n.sequences .encours::after { background: var(--erreur); }\n.reel-camera .camera-haut { top: 50px; }\n.chrono { display: inline-flex; flex: 1; justify-content: center; align-items: center; gap: 8px; font-weight: 700; font-size: 15px; font-variant-numeric: tabular-nums; }\n.rec { width: 10px; height: 10px; border-radius: 50%; background: var(--erreur); animation: clignote 1.2s steps(1) infinite; }\n\n/* ------------------------------------------------------------ E28 monter le reel */\n.montage { background: #0b0d14; color: #fff; }\n.montage .barre-etat { color: #fff; }\n.montage-haut { padding: 0 var(--marge-app); }\n.montage-haut .rond-verre.givre { color: var(--texte); }\n.apercu-reel { position: relative; height: 54vh; margin: 4px var(--marge-app) 0; overflow: hidden; border-radius: 24px; }\n@media (min-width: 600px) { .apercu-reel { width: min(100% - 56px, 420px); margin-inline: auto; } }\n.apercu-reel .photo { height: 100%; aspect-ratio: auto; }\n.texte-reel { position: absolute; left: 50%; top: 38%; translate: -50% 0; padding: 6px 12px; border-radius: 10px; background: #fff; color: var(--texte); font-size: 18px; font-weight: 700; white-space: nowrap; }\n.lecture-reel { position: absolute; left: 14px; bottom: 14px; display: grid; place-items: center; width: 44px; height: 44px; border: none; border-radius: 50%; background: #fff; color: var(--texte); }\n.temps-reel { position: absolute; right: 14px; bottom: 24px; font-size: 13px; font-weight: 700; font-variant-numeric: tabular-nums; }\n.outils { display: flex; justify-content: space-around; margin: 18px var(--marge-app) 16px; }\n.outil { display: grid; justify-items: center; gap: 6px; border: none; background: none; color: #fff; font-size: 12px; font-weight: 600; cursor: pointer; }\n.outil-icone { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: hsl(0 0% 100% / 0.12); }\n.outil.danger { color: var(--erreur); }\n.frise { position: relative; display: flex; gap: 4px; margin: 0 var(--marge-app); }\n.segment { position: relative; flex: var(--l) 1 0; height: 64px; overflow: hidden; border-radius: 12px; animation: monte 0.7s calc(0.4s + var(--n) * 0.06s) var(--signature) both; }\n.segment .photo { height: 100%; aspect-ratio: auto; opacity: 0.85; }\n.segment-duree { position: absolute; left: 8px; bottom: 6px; font-size: 11.5px; font-weight: 700; }\n/* La sequence choisie : cadree de blanc, ses poignees pour couper. */\n.segment.choisi { box-shadow: inset 0 0 0 3px #fff; }\n.segment.choisi::before, .segment.choisi::after { content: ''; position: absolute; z-index: 1; top: 0; bottom: 0; width: 12px; background: #fff; }\n.segment.choisi::before { left: 0; }\n.segment.choisi::after { right: 0; }\n.tete-lecture { position: absolute; z-index: 2; top: -8px; bottom: -8px; left: 26%; width: 3px; border-radius: 2px; background: var(--limonade); }\n\n/* ------------------------------------------------------------ E29 son */\n.son-feuille { gap: 10px; color: var(--texte); }\n.son-feuille .flux { margin: 0 6px; }\n.pistes { display: grid; gap: 2px; }\n.piste { display: flex; align-items: center; gap: 12px; padding: 8px; border-radius: 16px; animation: monte 0.7s calc(0.8s + var(--n) * 0.05s) var(--signature) both; }\n.piste.choisie { background: hsl(0 0% 100% / 0.8); }\n.piste > div { display: grid; flex: 1; gap: 1px; font-size: 13px; color: var(--discret); }\n.piste strong { color: var(--texte); font-size: 15px; }\n.piste-icone { display: grid; flex: none; place-items: center; width: 42px; height: 42px; border-radius: 12px; background: var(--texte); color: #fff; }\n.piste-icone .ic { width: 18px; height: 18px; }\n.piste-coche { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--texte); color: #fff; }\n.piste-coche .ic { width: 15px; height: 15px; stroke-width: 2.4; }\n.melange { display: flex; align-items: center; gap: 12px; padding: 4px 6px; font-weight: 600; font-size: 14px; }\n.melange > span:first-child { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }\n.curseur-volume { position: relative; flex: 1; height: 4px; border-radius: 2px; background: hsl(229 30% 30% / 0.15); }\n.curseur-volume::before { content: ''; position: absolute; inset: 0 auto 0 0; width: var(--v); border-radius: 2px; background: var(--texte); }\n.curseur-volume::after { content: ''; position: absolute; top: 50%; left: var(--v); width: 20px; height: 20px; translate: -50% -50%; border-radius: 50%; background: #fff; box-shadow: 0 2px 8px hsl(229 50% 20% / 0.3); }\n\n/* ------------------------------------------------------------ E14 details */\n.details-apercu { display: flex; align-items: flex-end; gap: 14px; margin: 4px 0 22px; animation: monte 0.8s 0.25s var(--signature) both; }\n.details-apercu .carte-image { flex: none; width: 128px; }\n.details-apercu .carte-image .badge { height: 22px; font-size: 10.5px; padding: 0 8px 0 5px; }\n.details-apercu .carte-image .badge .ic { width: 14px; height: 14px; }\n.details-infos { display: grid; gap: 8px; font-size: 13.5px; font-weight: 600; }\n.details-infos span { display: inline-flex; align-items: center; gap: 8px; }\n.details-infos .ic { width: 20px; height: 20px; }\n.types { display: flex; flex-wrap: wrap; gap: 6px; }\n.types .pastille { height: 32px; font-size: 13px; }\n.bouton-verre.plein .bouton-verre-texte .ic { margin-right: 6px; }\n\n/* ------------------------------------------------------------ E15 completer */\n.manque { margin-bottom: 20px; animation: monte 0.8s calc(0.4s + var(--n) * 0.07s) var(--signature) both; }\n.manque .champ-libelle { display: flex; align-items: center; gap: 8px; margin: 0 0 10px; }\n.manque .champ-libelle .ic { width: 20px; height: 20px; }\n.manque .champ-aide { margin-top: 8px; }\n.modeles { display: grid; margin-top: 8px; border-radius: 18px; overflow: hidden; }\n.modele { display: flex; align-items: center; gap: 12px; padding: 12px 14px; font-size: 14.5px; }\n.modele + .modele { border-top: 1px solid hsl(229 30% 30% / 0.08); }\n.modele > div { display: grid; }\n.modele span:not(.radio) { color: var(--discret); font-size: 12.5px; }\n.radio { flex: none; width: 22px; height: 22px; border-radius: 50%; box-shadow: inset 0 0 0 2px hsl(229 30% 30% / 0.3); }\n.modele.choisi .radio { box-shadow: inset 0 0 0 7px var(--texte); }\n.champ .fin { margin-left: auto; font-size: 14px; }\n/* Le modele absent de la liste : on l ajoute d un geste. */\n.modele-ajout { display: flex; align-items: center; gap: 12px; padding: 12px 14px; background: hsl(0 0% 100% / 0.75); }\n.modele-ajout > .ic { flex: none; width: 22px; height: 22px; padding: 2px; border-radius: 50%; background: var(--texte); color: #fff; stroke-width: 2.4; }\n.modele-ajout > div { display: grid; }\n.modele-ajout strong { font-size: 14.5px; }\n.modele-ajout span { color: var(--discret); font-size: 12.5px; }\n.modele-ajout + .modele { border-top: 1px solid hsl(229 30% 30% / 0.08); }\n.ce-telephone { display: inline-flex; align-items: center; gap: 6px; margin-top: 10px; padding: 8px 12px; border: none; border-radius: 999px; background: hsl(0 0% 100% / 0.6); font-size: 13px; font-weight: 600; cursor: pointer; }\n.ce-telephone .ic { width: 16px; height: 16px; }\n.resultat { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 14px; border-radius: 16px; background: hsl(0 0% 100% / 0.6); color: var(--discret); font-size: 13.5px; font-weight: 600; }\n\n/* ------------------------------------------------------------ E30 indiquer le lieu */\n.choisir-lieu { background: #eceef4; }\n.plan { position: absolute; inset: 0; width: 100%; height: 100%; }\n.choisir-lieu .barre-etat { position: relative; z-index: 3; }\n.lieu-haut { position: absolute; z-index: 3; top: 44px; left: var(--marge-app); right: var(--marge-app); display: flex; gap: 8px; }\n.lieu-haut .champ { flex: 1; min-height: 44px; padding-block: 0; }\n.givre-champ { background: hsl(0 0% 100% / 0.88); }\n.epingle-carte { position: absolute; z-index: 2; left: 50%; top: 40%; display: grid; justify-items: center; translate: -50% -100%; animation: repere-tombe 0.9s 0.4s cubic-bezier(0.2, 1.3, 0.35, 1) both; }\n.epingle-carte .ic { width: 56px; height: 56px; }\n.epingle-ombre { width: 14px; height: 5px; margin-top: -3px; border-radius: 50%; background: hsl(229 40% 15% / 0.3); }\n.ma-position { position: absolute; z-index: 3; right: var(--marge-app); bottom: 250px; }\n.lieu-choisi { position: absolute; z-index: 3; left: 8px; right: 8px; bottom: 8px; display: grid; gap: 14px; padding: 16px; border-radius: 28px; background: hsl(229 40% 97%); animation: feuille-monte 0.7s 0.3s var(--signature) both; }\n@media (min-width: 600px) { .lieu-choisi { left: 50%; right: auto; width: 460px; translate: -50% 0; } }\n.lieu-indice { margin: 0; color: var(--discret); font-size: 13px; text-align: center; }\n.lieu-ligne-choix { display: flex; align-items: center; gap: 12px; }\n.lieu-ligne-choix > div { display: grid; gap: 2px; font-size: 13px; color: var(--discret); }\n.lieu-ligne-choix strong { color: var(--texte); font-size: 16px; }\n.lieu-pastille { display: grid; flex: none; place-items: center; width: 44px; height: 44px; border-radius: 14px; background: #fff; }\n\n/* ------------------------------------------------------------ E16 envoi en route */\n.toast { position: fixed; z-index: 45; top: 44px; left: 50%; display: inline-flex; align-items: center; gap: 8px; translate: -50% 0; width: max-content; max-width: calc(100% - 32px); padding: 10px 16px 10px 12px; border-radius: 999px; background: var(--texte); color: #fff; font-size: 13.5px; font-weight: 600; animation: toast 4s 0.3s var(--signature) both; }\n.toast .ic { width: 18px; height: 18px; color: var(--limonade); stroke-width: 2.4; }\n@keyframes toast { 0% { transform: translateY(-140%); } 12%, 100% { transform: none; } }\n.envoi-pastille { position: fixed; z-index: 41; left: 50%; bottom: calc(var(--haut-onglets) + 24px); display: flex; align-items: center; gap: 12px; width: min(100% - 2 * var(--marge-app), 440px); translate: -50% 0; padding: 10px 10px 10px 10px; border-radius: 20px; background: hsl(229 40% 97%); animation: monte 0.8s 0.6s var(--signature) both; }\n.envoi-pastille > .photo { flex: none; width: 44px; height: 44px; border-radius: 12px; aspect-ratio: auto; }\n.envoi-pastille > div { display: grid; flex: 1; gap: 2px; min-width: 0; font-size: 12.5px; color: var(--discret); }\n.envoi-pastille strong { color: var(--texte); font-size: 14px; }\n.barre-envoi { position: relative; height: 4px; margin-top: 4px; overflow: hidden; border-radius: 2px; background: hsl(229 30% 30% / 0.12); }\n.barre-envoi::after { content: ''; position: absolute; inset: 0 auto 0 0; width: var(--p); border-radius: 2px; background: var(--ocean); }\n\n/* ------------------------------------------------------------ E26 mes envois */\n.envois { display: grid; gap: 8px; margin-bottom: 20px; }\n.envoi { display: flex; align-items: center; gap: 12px; padding: 10px; border-radius: 18px; background: hsl(0 0% 100% / 0.6); animation: monte 0.8s calc(0.35s + var(--n) * 0.05s) var(--signature) both; }\n.envoi > .photo { flex: none; width: 56px; height: 56px; border-radius: 14px; aspect-ratio: auto; }\n.envoi > div:not(.envoi-actions) { display: grid; flex: 1; gap: 3px; min-width: 0; }\n.envoi strong { font-size: 14.5px; }\n.envoi-detail { display: inline-flex; align-items: center; gap: 5px; color: var(--discret); font-size: 12.5px; }\n.envoi-detail .ic { width: 16px; height: 16px; }\n.envoi-actions { display: flex; flex: none; align-items: center; gap: 6px; }\n.envoi.pause .barre-envoi::after { background: hsl(229 15% 60%); }\n.envoi.refuse .envoi-detail { color: var(--erreur); }\n.envoi.publie .envoi-detail .ic { color: var(--texte); }\n.envoi .lien-encre { font-size: 13.5px; }\n\n/* ---- styles/messages.css ---- */\n/* USW : les messages et les erreurs (E37). Rien n arrete l utilisateur\n   quand tout va bien ; quand quelque chose coince, une phrase dit quoi faire,\n   avec une seule action principale. Le rouge de la charte pour ce qui est\n   refuse ou ce qui coupe ; les icones restent a l encre. */\n\n/* ------------------------------------------------------------ un champ en erreur */\n.champ-bloc.erreur .champ { outline-color: var(--erreur); }\n.champ-bloc.erreur .champ-aide { color: var(--erreur); }\n.champ-bloc.erreur .champ-aide .ic { color: var(--erreur); }\n/* Le champ tremble une fois, a l arrivee de l erreur. */\n.champ-bloc.erreur .champ { animation: tremble 0.45s 0.5s var(--interface); }\n@keyframes tremble { 20% { transform: translateX(-6px); } 40% { transform: translateX(5px); } 60% { transform: translateX(-3px); } 80% { transform: translateX(2px); } }\n\n/* ------------------------------------------------------------ un ecran d etat */\n.etat { display: flex; flex-direction: column; }\n.etat-haut { padding: 0 var(--marge-app); }\n.etat-corps { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; padding: 0 calc(var(--marge-app) + 8px) 12vh; text-align: center; }\n.etat-icone { display: grid; place-items: center; width: 76px; height: 76px; margin-bottom: 18px; border-radius: 24px; background: hsl(0 0% 100% / 0.75); box-shadow: 0 16px 34px -24px hsl(229 50% 20% / 0.5); animation: monte 0.8s 0.15s var(--signature) both; }\n.etat-icone .ic { width: 36px; height: 36px; }\n.etat-titre { margin: 0 0 8px; font-size: 26px; font-weight: 700; letter-spacing: -0.03em; line-height: 1.12; }\n.etat-texte { max-width: 34ch; margin: 0 0 26px; color: var(--discret); font-size: 15px; line-height: 1.5; animation: monte 0.8s 0.35s var(--signature) both; }\n.etat-actions { display: grid; gap: 8px; width: min(100%, 360px); animation: monte 0.8s 0.45s var(--signature) both; }\n.danger-etat .etat-icone { background: hsl(0 84% 60% / 0.12); color: var(--erreur); }\n.bouton-verre.rouge { color: #fff; background: var(--erreur); box-shadow: 0 10px 22px -12px hsl(0 84% 45% / 0.7); }\n\n/* ------------------------------------------------------------ la fenetre de confirmation */\n.dialogue {\n  position: fixed;\n  z-index: 52;\n  left: 50%;\n  top: 50%;\n  display: grid;\n  justify-items: center;\n  width: min(100% - 40px, 360px);\n  padding: 24px 20px 18px;\n  border-radius: 28px;\n  background: hsl(229 40% 97%);\n  text-align: center;\n  translate: -50% -50%;\n  animation: dialogue-entre 0.5s 0.6s var(--signature) both;\n}\n@keyframes dialogue-entre { from { transform: scale(0.92); opacity: 0; } }\n.dialogue-icone { display: grid; place-items: center; width: 52px; height: 52px; margin-bottom: 12px; border-radius: 16px; background: hsl(0 84% 60% / 0.12); color: var(--erreur); }\n.dialogue h2 { margin: 0 0 6px; font-size: 20px; font-weight: 700; letter-spacing: -0.02em; }\n.dialogue p { margin: 0 0 18px; color: var(--discret); font-size: 14.5px; line-height: 1.5; }\n.dialogue-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; width: 100%; }\n.dialogue-actions .bouton-verre { min-height: 46px; }\n\n/* ------------------------------------------------------------ les bulles et les messages */\n/* La bulle d aide : posee sous le badge, sa pointe vers lui. */\n.photo-grande .badge.verifie { z-index: 3; }\n.bulle-aide {\n  position: absolute;\n  z-index: 4;\n  left: 12px;\n  bottom: 52px;\n  display: grid;\n  gap: 3px;\n  width: min(270px, calc(100% - 24px));\n  padding: 12px 14px;\n  border-radius: 16px;\n  background: var(--texte);\n  color: hsl(0 0% 100% / 0.82);\n  font-size: 13px;\n  line-height: 1.45;\n  animation: bulle-entre 0.5s 0.9s var(--signature) both;\n}\n.bulle-aide::after { content: ''; position: absolute; left: 26px; bottom: -6px; width: 12px; height: 12px; border-radius: 2px; background: inherit; rotate: 45deg; }\n.bulle-aide strong { color: #fff; font-size: 14px; }\n.bulle-aide .lien-encre { color: #fff; font-size: 13px; }\n@keyframes bulle-entre { from { transform: translateY(8px) scale(0.96); opacity: 0; } }\n/* Le message : un bandeau a l encre, en bas, qui part seul apres 4 s. */\n.message {\n  position: fixed;\n  z-index: 45;\n  left: 50%;\n  bottom: calc(var(--haut-onglets) + 26px);\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  width: min(100% - 2 * var(--marge-app), 420px);\n  padding: 8px 14px 8px 8px;\n  border-radius: 18px;\n  background: var(--texte);\n  color: #fff;\n  font-size: 14px;\n  translate: -50% 0;\n  animation: message 4.5s 0.6s var(--signature) both;\n}\n.message .photo { flex: none; width: 40px; height: 40px; border-radius: 10px; aspect-ratio: auto; }\n.message span:not(.photo) { flex: 1; }\n.message-action { color: var(--limonade); font-weight: 700; cursor: pointer; }\n@keyframes message { 0% { transform: translateY(140%); } 10%, 100% { transform: none; } }\n\n/* ------------------------------------------------------------ un etat vide dans une page */\n.vide { display: grid; justify-items: center; padding: 48px calc(var(--marge-app) + 8px) 24px; text-align: center; }\n.vide h2 { margin: 0 0 8px; font-size: 21px; font-weight: 700; letter-spacing: -0.02em; animation: monte 0.8s 0.3s var(--signature) both; }\n.vide p { max-width: 34ch; margin: 0 0 22px; color: var(--discret); font-size: 14.5px; line-height: 1.5; animation: monte 0.8s 0.38s var(--signature) both; }\n.vide-recherche { padding-top: 28px; }\n.vide-recherche .etat-icone { width: 64px; height: 64px; border-radius: 20px; }\n.vide-recherche .etat-icone .ic { width: 30px; height: 30px; }\n\n/* ------------------------------------------------------------ la banniere (2026-10-23) */\n/* Le message apres une action, comme une notification d iOS : du verre depoli\n   qui descend du haut avec un ressort, le logo dans sa tuile, « USW ·\n   maintenant », le texte. Il part seul, ou d un geste vers le haut. */\n.banniere {\n  position: fixed;\n  z-index: 46;\n  top: 40px;\n  left: 50%;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  width: min(100% - 16px, 440px);\n  padding: 12px 14px;\n  border-radius: 24px;\n  background: hsl(0 0% 100% / 0.55);\n  -webkit-backdrop-filter: blur(18px) saturate(1.8);\n  backdrop-filter: blur(18px) saturate(1.8);\n  box-shadow: inset 0 1px 0.5px hsl(0 0% 100% / 0.9), 0 0 0 0.5px hsl(229 40% 30% / 0.12), 0 18px 40px -22px hsl(229 50% 20% / 0.5);\n  translate: -50% 0;\n  animation: banniere 0.6s 0.4s var(--ressort) both;\n}\n@keyframes banniere { from { transform: translateY(-140%) scale(0.96); } }\n.banniere-logo { display: grid; flex: none; place-items: center; width: 38px; height: 38px; border-radius: 10px; background: linear-gradient(135deg, #fff, hsl(229 45% 93%)); }\n.banniere-logo .logo { width: 26px; height: 26px; }\n.banniere > div { flex: 1; min-width: 0; }\n.banniere-tete { display: flex; justify-content: space-between; gap: 8px; font-size: 13.5px; }\n.banniere-tete span { color: var(--discret); font-size: 12.5px; }\n.banniere p { margin: 1px 0 0; color: var(--texte); font-size: 14px; line-height: 1.35; }\n.banniere-action { flex: none; color: var(--texte); font-size: 14px; font-weight: 700; text-decoration: underline; }\n\n/* ---- styles/feuilles.css ---- */\n/* USW : les feuilles et les dernieres pages. Filtres (E04), commentaires\n   (E07), telecharger l original (E08), enregistrer (E09), partager (E10),\n   carte des reels (E11), collection (E19), signaler (E22), regles (E23),\n   moderation (E24, E25), confidentialite (E38). La feuille de base est dans\n   profil.css ; ici, son en-tete, ses hauteurs et ce qu elle contient. */\n\n/* ------------------------------------------------------------ la feuille */\n/* Sur une page sombre (les reels), la feuille garde l encre. */\n.feuille { gap: 14px; padding: 8px 16px 16px; max-height: calc(100% - 60px); color: var(--texte); }\n.reels .feuille .verre:not(.rouge), .reels .feuille .rond-verre { color: var(--texte); }\n.feuille-poignee { margin-bottom: 0; }\n.feuille-tete { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 38px; }\n.feuille-tete h2 { margin: 0; font-size: 20px; font-weight: 700; letter-spacing: -0.02em; }\n/* Les longues listes : la feuille monte haut, sa liste defile, la saisie reste en bas. */\n.feuille.haute { top: 14%; grid-template-rows: auto auto 1fr auto; overflow: hidden; }\n@media (min-width: 600px) { .feuille.haute { top: 18%; width: 520px; } .feuille-large { width: 480px; } }\n.feuille-texte { margin: -6px 0 0; color: var(--discret); font-size: 14.5px; line-height: 1.5; }\n.feuille-note { margin: 0; color: var(--discret); font-size: 13px; line-height: 1.5; text-align: center; }\n.feuille-sous-titre { margin: 4px 0 -4px; color: var(--texte); font-size: 15.5px; font-weight: 700; }\n.feuille .bouton-verre.large { width: 100%; }\n.feuille .modeles { margin-top: 0; background: #fff; }\n.feuille-pied { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 4px; }\n.feuille-pied .bouton-verre { flex: 1; max-width: 240px; min-height: 50px; }\n.feuille-pied .lien-encre { border: none; background: none; font-size: 15px; }\n\n/* ------------------------------------------------------------ E04 filtres */\n.filtre-groupe { display: grid; gap: 10px; }\n.filtre-groupe h3 { display: flex; justify-content: space-between; margin: 0; font-size: 15px; font-weight: 700; }\n.filtre-groupe h3 span { color: var(--discret); font-weight: 600; font-size: 13.5px; }\n.filtre-groupe .champ { min-height: 48px; padding-block: 0; background: #fff; }\n.pastilles { display: flex; flex-wrap: wrap; gap: 8px; }\n.feuille .pastille:not([aria-checked='true']) { background: #fff; }\n.curseur-rayon { position: relative; height: 28px; }\n.rail { position: absolute; left: 0; right: 0; top: 12px; height: 4px; border-radius: 2px; background: hsl(229 30% 30% / 0.14); }\n.rail-plein { position: absolute; inset: 0 auto 0 0; width: var(--p); border-radius: inherit; background: var(--texte); }\n.bouton-rayon { position: absolute; top: 0; left: var(--p); width: 28px; height: 28px; margin-left: -14px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 1px hsl(229 30% 30% / 0.08), 0 4px 12px -2px hsl(229 50% 20% / 0.3); }\n.rayon-reperes { display: flex; justify-content: space-between; margin-top: -4px; color: var(--discret); font-size: 12px; }\n.filtre-ligne { display: flex; align-items: center; gap: 14px; }\n.filtre-ligne > div { display: grid; flex: 1; gap: 2px; color: var(--discret); font-size: 13px; }\n.filtre-ligne strong { color: var(--texte); font-size: 15px; }\n\n/* ------------------------------------------------------------ E07 commentaires */\n.avis-liste { display: grid; align-content: start; gap: 18px; margin: 0 -16px; padding: 4px 16px 12px; overflow: hidden; }\n.avis { display: flex; gap: 10px; }\n.avis .avatar.petit { width: 34px; height: 34px; }\n.avis-corps { flex: 1; min-width: 0; }\n.avis-corps p { margin: 0; font-size: 14.5px; line-height: 1.45; }\n.avis-corps b { font-weight: 700; }\n.avis .epingle { display: inline-flex; align-items: center; gap: 4px; margin-bottom: 3px; color: var(--discret); font-size: 12px; font-weight: 600; }\n.marque-auteur { margin-left: 6px; padding: 1px 7px; border-radius: 6px; background: var(--texte); color: #fff; font-size: 11px; font-weight: 700; vertical-align: 1px; }\n.mention { color: var(--ocean); font-weight: 600; }\n.avis-pied { display: flex; gap: 16px; margin-top: 4px; color: var(--discret); font-size: 12.5px; }\n.avis-pied button { padding: 0; border: none; background: none; color: inherit; font: inherit; font-weight: 700; cursor: pointer; }\n.avis-aime { display: grid; justify-items: center; align-self: start; gap: 1px; padding: 2px 0 0; border: none; background: none; color: var(--discret); font-size: 11.5px; font-weight: 600; cursor: pointer; }\n.avis-aime .ic { width: 18px; height: 18px; }\n/* Aime : le coeur se remplit au rouge de la charte. */\n.avis-aime.aime .ic { color: var(--erreur); fill: var(--erreur); }\n.reponses { display: grid; gap: 12px; margin-top: 12px; }\n.reponses .avatar.petit { width: 26px; height: 26px; font-size: 10px; }\n.voir-reponses { display: flex; align-items: center; gap: 10px; padding: 0; border: none; background: none; color: var(--discret); font-size: 12.5px; font-weight: 700; cursor: pointer; }\n.voir-reponses span { width: 22px; height: 1px; background: currentColor; }\n.saisie-bloc { position: relative; display: grid; gap: 8px; margin: 0 -16px -16px; padding: 10px 16px 16px; border-top: 1px solid hsl(229 30% 30% / 0.08); background: hsl(229 40% 97%); }\n.mentions { position: absolute; left: 16px; right: 16px; bottom: calc(100% + 6px); display: grid; padding: 6px; border-radius: 18px; background: #fff; box-shadow: 0 18px 40px -20px hsl(229 50% 20% / 0.45); animation: bulle-entre 0.5s 0.9s var(--signature) both; }\n.mention-ligne { display: flex; align-items: center; gap: 10px; padding: 8px; border-radius: 12px; }\n.mention-ligne.choisie { background: var(--secondaire); }\n.mention-ligne > div { display: grid; color: var(--discret); font-size: 12.5px; }\n.mention-ligne strong { color: var(--texte); font-size: 14px; }\n.repondre-a { display: flex; align-items: center; gap: 6px; color: var(--discret); font-size: 12.5px; }\n.repondre-a b { color: var(--texte); }\n.repondre-a button { display: grid; place-items: center; padding: 2px; border: none; background: none; color: var(--discret); cursor: pointer; }\n.saisie { display: flex; align-items: center; gap: 8px; }\n.saisie .champ { flex: 1; min-height: 46px; padding-block: 0; background: #fff; }\n.saisie .champ-valeur { font-size: 14.5px; }\n.saisie .envoyer { flex: none; color: #fff; background: var(--texte); }\n\n/* ------------------------------------------------------------ E08 telecharger l original */\n.fichier-ligne { display: flex; align-items: center; gap: 12px; }\n.fichier-ligne .photo { flex: none; width: 64px; height: 64px; border-radius: 14px; aspect-ratio: auto !important; }\n.fichier-ligne > div { display: grid; gap: 1px; color: var(--discret); font-size: 13px; }\n.fichier-ligne strong { color: var(--texte); font-size: 14.5px; word-break: break-all; }\n.avertissement { display: flex; gap: 10px; padding: 12px 14px; border-radius: 16px; background: hsl(45 100% 50% / 0.14); }\n.avertissement .ic { flex: none; width: 20px; height: 20px; color: hsl(35 90% 32%); }\n.avertissement p { display: grid; gap: 2px; margin: 0; color: hsl(229 20% 28%); font-size: 13.5px; line-height: 1.45; }\n.avertissement strong { color: var(--texte); font-size: 14.5px; }\n\n/* ------------------------------------------------------------ E09 enregistrer */\n.collections { display: grid; gap: 2px; margin: 0 -8px; }\n.collection-ligne { display: flex; align-items: center; gap: 12px; padding: 8px; border-radius: 18px; animation: monte 0.7s calc(0.8s + var(--n) * 0.05s) var(--signature) both; }\n.collection-ligne.choisie { background: #fff; }\n.collection-vignettes { display: grid; flex: none; grid-template-columns: 2fr 1fr; grid-template-rows: 1fr 1fr; gap: 2px; width: 60px; height: 60px; border-radius: 14px; overflow: hidden; }\n.collection-vignettes .photo { aspect-ratio: auto !important; height: 100%; }\n.collection-vignettes .photo:first-child { grid-row: span 2; }\n.collection-ligne > div { display: grid; flex: 1; gap: 2px; }\n.collection-ligne strong { font-size: 15.5px; }\n.collection-ligne span:not(.photo):not(.collection-vignettes):not(.coche-ronde) { display: inline-flex; align-items: center; gap: 4px; color: var(--discret); font-size: 13px; }\n.coche-ronde { display: grid; flex: none; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--texte); color: #fff; }\n.coche-ronde .ic { width: 16px; height: 16px; stroke-width: 2.6; }\n.nouvelle-collection { display: flex; align-items: center; gap: 12px; padding: 8px 0; border: none; background: none; font-size: 15.5px; font-weight: 700; cursor: pointer; }\n.nouvelle-collection .ic { width: 60px; height: 60px; padding: 18px; border-radius: 14px; background: #fff; }\n\n/* ------------------------------------------------------------ E10 partager */\n.partage-apercu { display: flex; align-items: center; gap: 12px; padding: 10px; border-radius: 20px; background: #fff; }\n.partage-apercu .photo { flex: none; width: 56px; height: 72px; border-radius: 12px; aspect-ratio: auto !important; }\n.partage-apercu > div { display: grid; gap: 1px; color: var(--discret); font-size: 13px; }\n.partage-apercu strong { color: var(--texte); font-size: 15px; }\n.lien-court { color: var(--texte); font-weight: 600; }\n.membres, .applis { display: flex; justify-content: space-between; gap: 6px; }\n.membre, .appli { display: grid; justify-items: center; gap: 6px; width: 64px; padding: 0; border: none; background: none; font-size: 12px; font-weight: 600; cursor: pointer; }\n.membre .avatar { width: 54px; height: 54px; font-size: 17px; }\n/* Toucher un membre le choisit : un anneau ocean et une coche qui rebondit.\n   Le premier rond cherche un membre hors des recents. */\n.membre-avatar { position: relative; display: grid; place-items: center; width: 54px; height: 54px; border-radius: 50%; }\n.membre.choisi .avatar { box-shadow: 0 0 0 2.5px var(--fond), 0 0 0 4.5px var(--ocean); }\n.membre-coche { position: absolute; right: -3px; bottom: -3px; display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--ocean); color: #fff; box-shadow: 0 0 0 2px var(--fond); animation: monte 0.5s 0.5s var(--ressort) both; }\n.membre-coche .ic { width: 13px; height: 13px; stroke-width: 2.4; }\n.membre.chercher .membre-avatar { background: hsl(229 30% 90%); color: var(--texte); }\n.membre.chercher .membre-avatar .ic { width: 24px; height: 24px; }\n.envoi-membres { display: grid; gap: 10px; }\n.appli-icone { display: grid; place-items: center; width: 54px; height: 54px; border-radius: 50%; background: #fff; }\n.appli-icone .ic { width: 24px; height: 24px; }\n.appli-icone.marque .ic { width: 54px; height: 54px; }\n.appli-icone.marque { background: none; }\n\n/* ------------------------------------------------------------ E22 signaler */\n.feuille-signaler .motifs { overflow: hidden; }\n.motifs .modele { padding-block: 11px; }\n.feuille .champ.zone { align-items: flex-start; min-height: 0; padding-block: 12px; background: #fff; }\n.feuille .champ.zone .ic { margin-top: 2px; }\n\n/* ------------------------------------------------------------ E11 carte des reels */\n.carte-reels { background: #eceef4; }\n.carte-reels .barre-etat { position: relative; z-index: 3; }\n.carte-haut { position: absolute; z-index: 3; top: 44px; left: var(--marge-app); right: var(--marge-app); display: grid; gap: 10px; }\n.lieu-haut-ligne { display: flex; gap: 8px; }\n.lieu-haut-ligne .champ { flex: 1; min-height: 44px; padding-block: 0; }\n.carte-haut .filtres { margin-right: calc(-1 * var(--marge-app)); }\n.carte-haut .pastille:not([aria-checked='true']) { background: hsl(0 0% 100% / 0.88); }\n/* Un contenu sur la carte : sa photo dans un cadre blanc, la pointe vers le lieu. */\n.repere-contenu {\n  position: absolute;\n  z-index: 2;\n  left: var(--x);\n  top: var(--y);\n  width: 52px;\n  height: 52px;\n  padding: 3px;\n  border: none;\n  border-radius: 16px;\n  background: #fff;\n  box-shadow: 0 10px 20px -10px hsl(229 50% 20% / 0.6);\n  translate: -50% -100%;\n  cursor: pointer;\n  animation: repere-tombe 0.8s calc(0.4s + var(--n) * 0.08s) var(--signature) both;\n}\n.repere-contenu::after { content: ''; position: absolute; left: 50%; bottom: -5px; width: 12px; height: 12px; margin-left: -6px; border-radius: 0 0 3px 0; background: inherit; rotate: 45deg; }\n.repere-contenu .photo { height: 100%; border-radius: 13px; aspect-ratio: auto !important; }\n.repere-contenu.choisi { z-index: 3; width: 68px; height: 68px; background: var(--texte); }\n.repere-contenu.choisi .photo { border-radius: 13px; }\n.repere-reel { position: absolute; right: -6px; top: -6px; display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--texte); color: #fff; box-shadow: 0 0 0 2px #fff; }\n.repere-reel .ic { width: 11px; height: 11px; fill: currentColor; }\n.groupe-reperes { position: absolute; z-index: 2; left: var(--x); top: var(--y); display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--texte); color: #fff; font-size: 14px; font-weight: 700; box-shadow: 0 0 0 4px hsl(0 0% 100% / 0.7); translate: -50% -50%; animation: fondu 0.6s 0.9s var(--interface) both; }\n.ma-position-point { position: absolute; z-index: 2; left: var(--x); top: var(--y); width: 18px; height: 18px; border-radius: 50%; background: #4285f4; box-shadow: 0 0 0 3px #fff, 0 0 0 14px hsl(217 89% 61% / 0.18); translate: -50% -50%; }\n.carte-reels .ma-position { bottom: calc(var(--haut-onglets) + 222px); }\n.carte-apercu {\n  position: absolute;\n  z-index: 3;\n  left: 8px;\n  right: 8px;\n  bottom: calc(var(--haut-onglets) + 24px);\n  display: flex;\n  gap: 12px;\n  padding: 10px;\n  border-radius: 26px;\n  background: hsl(229 40% 97%);\n  animation: feuille-monte 0.7s 0.8s var(--signature) both;\n}\n@media (min-width: 600px) { .carte-apercu { left: 50%; right: auto; width: 460px; translate: -50% 0; } }\n.carte-apercu > .photo { position: relative; flex: none; width: 96px; height: 150px; border-radius: 18px; aspect-ratio: auto !important; }\n.apercu-texte { display: grid; flex: 1; align-content: start; gap: 4px; min-width: 0; color: var(--discret); font-size: 12.5px; }\n.apercu-texte strong { color: var(--texte); font-size: 16px; }\n.apercu-texte > span:not(.badge) { display: flex; align-items: center; gap: 4px; }\n.apercu-texte .badge { justify-self: start; height: 24px; font-size: 11.5px; }\n.apercu-actions { display: grid; gap: 6px; margin-top: auto; padding-top: 6px; }\n.apercu-actions .bouton-verre { min-height: 40px; font-size: 14px; }\n\n/* ------------------------------------------------------------ E19 une collection */\n.collection-tete { display: grid; justify-items: center; padding: 4px var(--marge-app) 6px; text-align: center; }\n.collection-couverture { display: grid; grid-template-columns: 2fr 1fr; grid-template-rows: 1fr 1fr; gap: 3px; width: 168px; height: 128px; border-radius: 26px; overflow: hidden; animation: monte 0.8s 0.1s var(--signature) both; }\n.collection-couverture .photo { height: 100%; aspect-ratio: auto !important; }\n.collection-couverture .photo:first-child { grid-row: span 2; }\n.collection-tete .profil-pseudo { display: inline-flex; align-items: center; gap: 4px; margin-bottom: 18px; }\n\n/* ------------------------------------------------------------ E23 regles communautaires */\n.regles { display: grid; gap: 14px; margin-bottom: 26px; }\n.regle { display: flex; gap: 14px; padding: 16px; border-radius: 22px; background: hsl(0 0% 100% / 0.6); animation: monte 0.9s calc(0.45s + var(--n) * 0.05s) var(--signature) both; }\n.regle-icone { display: grid; flex: none; place-items: center; width: 42px; height: 42px; border-radius: 13px; background: #fff; }\n.regle-icone .ic { width: 22px; height: 22px; }\n.regle h2 { margin: 2px 0 4px; font-size: 16.5px; font-weight: 700; letter-spacing: -0.01em; }\n.regle p { margin: 0; color: hsl(229 20% 28%); font-size: 14.5px; line-height: 1.55; }\n.exemples { display: grid; gap: 6px; margin-top: 10px; }\n.exemples p { display: flex; gap: 8px; font-size: 13.5px; line-height: 1.45; }\n.exemples .ic { flex: none; width: 18px; height: 18px; margin-top: 1px; padding: 3px; border-radius: 50%; stroke-width: 2.6; }\n.exemples .oui .ic { background: var(--limonade); color: hsl(71 60% 14%); }\n.exemples .non .ic { background: hsl(0 84% 60% / 0.14); color: var(--erreur); }\n.sanctions { display: grid; margin: 0 0 6px; padding: 4px 16px; border-radius: 22px; list-style: none; }\n.sanctions li { display: flex; gap: 12px; padding: 12px 0; }\n.sanctions li + li { border-top: 1px solid hsl(229 30% 30% / 0.08); }\n.sanctions .numero { display: inline-grid; flex: none; place-items: center; width: 26px; height: 26px; border-radius: 8px; background: var(--texte); color: #fff; font-size: 13px; font-weight: 700; }\n.sanctions li div { display: grid; gap: 2px; color: var(--discret); font-size: 13.5px; }\n.sanctions strong { color: var(--texte); font-size: 15px; }\n.sanctions li:last-child .numero { background: var(--erreur); }\n\n/* ------------------------------------------------------------ E38 confidentialite */\n.en-bref { margin-bottom: 26px; padding: 16px; border-radius: 22px; animation: monte 0.9s 0.4s var(--signature) both; }\n.en-bref h2 { margin: 0 0 10px; font-size: 17px; font-weight: 700; }\n.en-bref ul { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }\n.en-bref li { display: flex; gap: 10px; font-size: 14.5px; line-height: 1.45; }\n.en-bref .ic { flex: none; width: 20px; height: 20px; padding: 3px; border-radius: 50%; background: var(--limonade); color: hsl(71 60% 14%); stroke-width: 2.6; }\n.donnees { display: grid; margin-bottom: 26px; padding: 0 16px; border-radius: 22px; }\n.donnee { display: flex; align-items: center; gap: 12px; padding: 12px 0; }\n.donnee + .donnee { border-top: 1px solid hsl(229 30% 30% / 0.08); }\n.donnee > .ic { flex: none; }\n.donnee > div { display: grid; flex: 1; gap: 1px; color: var(--discret); font-size: 13px; }\n.donnee strong { color: var(--texte); font-size: 14.5px; }\n.duree-garde { flex: none; max-width: 9em; color: var(--discret); font-size: 12.5px; font-weight: 600; text-align: right; }\n.droits { display: grid; justify-items: center; gap: 4px; margin-top: 26px; }\n.droits .bouton-verre { width: 100%; }\n\n/* ------------------------------------------------------------ E24 moderation, la file */\n.moderation .flux b { margin-left: 4px; padding: 1px 7px; border-radius: 999px; background: hsl(229 30% 30% / 0.1); font-size: 12px; }\n.moderation .flux span[aria-current='true'] b { background: var(--texte); color: #fff; }\n.file-note { margin: 0 0 14px; color: var(--discret); font-size: 13.5px; }\n.dossiers { display: grid; gap: 4px; }\n.dossier { display: flex; align-items: center; gap: 12px; padding: 10px; margin: 0 -10px; border-radius: 18px; animation: monte 0.8s calc(0.35s + var(--n) * 0.05s) var(--signature) both; }\n.dossier:first-child { background: hsl(0 0% 100% / 0.6); }\n.dossier .photo { flex: none; width: 58px; height: 72px; border-radius: 12px; aspect-ratio: auto !important; }\n.dossier-texte { display: grid; flex: 1; gap: 2px; min-width: 0; color: var(--discret); font-size: 13px; }\n.dossier-texte strong { color: var(--texte); font-size: 15px; }\n.raison { display: inline-flex; align-items: center; gap: 5px; justify-self: start; margin-top: 3px; padding: 3px 9px 3px 7px; border-radius: 999px; background: hsl(229 30% 30% / 0.08); color: var(--texte); font-size: 12px; font-weight: 600; }\n.raison.forte { background: hsl(0 84% 60% / 0.12); color: var(--erreur); }\n.raison .ic { width: 14px; height: 14px; }\n.dossier .quand { align-self: start; margin: 2px 0 0; }\n\n/* ------------------------------------------------------------ E25 moderation, la decision */\n.decision .page-haut-titre { flex: 1; text-align: center; margin-right: 44px; color: var(--discret); font-size: 14.5px; }\n.decision-image { margin-bottom: 14px; border-radius: 24px; overflow: hidden; animation: monte 0.8s 0.1s var(--signature) both; }\n.decision-image .photo { aspect-ratio: 4 / 3 !important; }\n.decision-auteur { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }\n.decision-auteur > div { display: grid; color: var(--discret); font-size: 13px; }\n.decision-auteur strong { color: var(--texte); font-size: 16px; }\n.analyse { margin-bottom: 14px; padding: 14px 16px; border-radius: 22px; animation: monte 0.9s 0.35s var(--signature) both; }\n.analyse-tete { display: flex; align-items: center; gap: 8px; }\n.analyse-tete strong { flex: 1; font-size: 15px; }\n.analyse-tete span { color: var(--erreur); font-size: 18px; font-weight: 700; }\n.jauge { position: relative; display: block; height: 6px; margin: 10px 0; border-radius: 3px; background: hsl(229 30% 30% / 0.1); overflow: hidden; }\n.jauge::after { content: ''; position: absolute; inset: 0; width: var(--p); border-radius: inherit; background: var(--erreur); transform-origin: left; animation: remplit 1s 0.6s var(--signature) both; }\n.analyse p { margin: 0; color: hsl(229 20% 28%); font-size: 13.5px; line-height: 1.5; }\n.decision .fiche { margin: 0 0 22px; }\n.compare-ligne { display: grid; grid-template-columns: 28px 1fr auto; align-items: start; gap: 4px 8px; padding: 10px 0; border-top: 1px solid hsl(229 30% 30% / 0.08); }\n.compare-ligne:first-child { border-top: none; }\n.compare-ligne dt { font-size: 12px; color: var(--discret); }\n.compare-ligne dd { display: grid; margin: 1px 0 0; font-weight: 600; font-size: 14px; }\n.compare-ligne dd span { color: var(--discret); font-weight: 400; font-size: 12px; }\n.accord { display: inline-flex; align-items: center; gap: 4px; color: var(--erreur); font-size: 12px; font-weight: 700; white-space: nowrap; }\n.accord.ok { color: hsl(140 55% 32%); }\n.accord .ic { width: 14px; height: 14px; }\n.decision .motifs { margin: 0 0 10px; background: #fff; }\n.decision-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 18px; }\n.decision-actions .bouton-verre .ic { width: 18px; height: 18px; stroke-width: 2.4; }\n/* Publier : la limonade, ce qui est sur. */\n.bouton-verre.valider { background: var(--limonade); color: hsl(71 60% 12%); box-shadow: 0 10px 22px -12px hsl(71 70% 35% / 0.7); }\n\n/* ------------------------------------------------------------ E06 reagir a un reel */\n/* Un toucher sur le coeur : les quatre reactions s ouvrent a sa gauche, chacune\n   avec son nom dessous ; le reel s assombrit un peu pour les laisser lire. */\n.voile-reagir { position: absolute; inset: 0; z-index: 2; background: hsl(229 40% 4% / 0.35); animation: fondu 0.3s 0.5s var(--interface) both; }\n.reels-cote .bouton-reel.appui { position: relative; z-index: 4; }\n.reels-cote .bouton-reel.appui .rond-verre { transform: scale(1.12); }\n.reactions-choix {\n  position: absolute;\n  right: calc(100% + 10px);\n  top: -8px;\n  display: flex;\n  gap: 2px;\n  padding: 6px;\n  border-radius: 28px;\n  background: hsl(229 40% 97%);\n  color: var(--texte);\n  box-shadow: 0 18px 40px -16px hsl(229 50% 4% / 0.7);\n  transform-origin: right center;\n  animation: reactions-entre 0.45s 0.55s var(--ressort) both;\n}\n@keyframes reactions-entre { from { transform: scale(0.6); opacity: 0; } }\n.reaction { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; width: 66px; height: 70px; padding: 0; border: none; border-radius: 22px; background: none; color: inherit; cursor: pointer; animation: monte 0.5s calc(0.65s + var(--k) * 0.05s) var(--ressort) both; }\n.reaction .emoji { font-size: 28px; line-height: 1; }\n.reaction-nom { max-width: 62px; font-size: 11px; font-weight: 600; line-height: 1.1; text-align: center; }\n/* La reaction sous le doigt grossit un peu. */\n.reaction.choisie { background: #fff; transform: scale(1.08); }\n\n/* ------------------------------------------------------------ E06 les reactions d un reel */\n.reactions-flux { gap: 18px; margin: -4px -16px 0; padding: 0 16px; overflow: hidden; font-size: 14.5px; white-space: nowrap; }\n.reacteurs { display: grid; align-content: start; gap: 4px; overflow: hidden; }\n.reacteur { display: flex; align-items: center; gap: 12px; padding: 6px 0; animation: monte 0.7s calc(0.8s + var(--n) * 0.05s) var(--signature) both; }\n.avatar-reaction { position: relative; flex: none; }\n.avatar-reaction .avatar { width: 46px; height: 46px; }\n.avatar-reaction .emoji { position: absolute; right: -4px; bottom: -4px; display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: #fff; font-size: 13px; box-shadow: 0 2px 6px hsl(229 50% 20% / 0.2); }\n.reacteur > div { display: grid; flex: 1; gap: 1px; color: var(--discret); font-size: 13px; }\n.reacteur strong { color: var(--texte); font-size: 15px; }\n.reacteur .bouton-verre { min-height: 38px; padding: 0 14px; font-size: 14px; }\n\n/* ------------------------------------------------------------ E06 commenter, partager, telecharger un reel */\n/* Un moment du reel, cite dans un commentaire : un appui y ramene la lecture. */\n.moment { padding: 1px 6px; border-radius: 6px; background: var(--secondaire); color: var(--texte); font-weight: 700; cursor: pointer; }\n.actions-reel { padding-top: 14px; border-top: 1px solid hsl(229 30% 30% / 0.08); }\n.appli-icone.rouge-doux { background: hsl(0 84% 60% / 0.12); color: var(--erreur); }\n.fichier-ligne .photo.vertical { width: 48px; height: 76px; border-radius: 10px; }\n\n/* ---- photos ---- */\n.ph-p10 { background-image: url(data:image/webp;base64,); aspect-ratio: 440 / 660; }\n.ph-p11 { background-image: url(data:image/webp;base64,); aspect-ratio: 440 / 550; }\n.ph-p12 { background-image: url(data:image/webp;base64,); aspect-ratio: 438 / 780; }\n.ph-p15 { background-image: url(data:image/webp;base64,); aspect-ratio: 440 / 660; }\n.ph-p17 { background-image: url(data:image/webp;base64,); aspect-ratio: 440 / 352; }\n.ph-p28 { background-image: url(data:image/webp;base64,); aspect-ratio: 440 / 704; }\n.ph-p29 { background-image: url(data:image/webp;base64,); aspect-ratio: 440 / 528; }\n.ph-p37 { background-image: url(data:image/webp;base64,); aspect-ratio: 440 / 352; }\n.ph-p46 { background-image: url(data:image/webp;base64,); aspect-ratio: 440 / 616; }\n.ph-p49 { background-image: url(data:image/webp;base64,); aspect-ratio: 440 / 528; }\n.ph-p54 { background-image: url(data:image/webp;base64,); aspect-ratio: 440 / 440; }\n.ph-p57 { background-image: url(data:image/webp;base64,); aspect-ratio: 440 / 352; }\n.ph-p58 { background-image: url(data:image/webp;base64,); aspect-ratio: 440 / 704; }\n.ph-p62 { background-image: url(data:image/webp;base64,); aspect-ratio: 438 / 780; }\n.ph-p66 { background-image: url(data:image/webp;base64,); aspect-ratio: 440 / 616; }\n.ph-p71 { background-image: url(data:image/webp;base64,); aspect-ratio: 440 / 550; }\n.ph-p74 { background-image: url(data:image/webp;base64,); aspect-ratio: 440 / 440; }\n.ph-p76 { background-image: url(data:image/webp;base64,); aspect-ratio: 440 / 616; }\n.ph-p77 { background-image: url(data:image/webp;base64,); aspect-ratio: 440 / 352; }\n.ph-p78 { background-image: url(data:image/webp;base64,); aspect-ratio: 440 / 704; }\n.ph-p92 { background-image: url(data:image/webp;base64,); aspect-ratio: 440 / 550; }\n.ph-p101 { background-image: url(data:image/webp;base64,); aspect-ratio: 440 / 528; }\n.ph-p108 { background-image: url(data:image/webp;base64,); aspect-ratio: 440 / 660; }\n.ph-p110 { background-image: url(data:image/webp;base64,); aspect-ratio: 440 / 352; }\n.ph-p116 { background-image: url(data:image/webp;base64,); aspect-ratio: 440 / 585; }\n.ph-p118 { background-image: url(data:image/webp;base64,); aspect-ratio: 440 / 660; }\n.ph-p124 { background-image: url(data:image/webp;base64,); aspect-ratio: 440 / 550; }\n.ph-p127 { background-image: url(data:image/webp;base64,); aspect-ratio: 440 / 440; }\n.ph-p128 { background-image: url(data:image/webp;base64,); aspect-ratio: 440 / 660; }\n.ph-p132 { background-image: url(data:image/webp;base64,); aspect-ratio: 440 / 528; }","jetons":[["--fond","Fond"],["--texte","Texte"],["--discret","Discret"],["--ocean","Océan"],["--limonade","Limonade"],["--erreur","Erreur"]],"stylesTexte":[[".sigle","Sigle d'ouverture"],[".marque","Marque"],[".lieu-titre","Nom du lieu"],[".photo-titre","Titre de contenu"],[".section-titre","Titre de section"],[".flux","Onglets de flux"],[".carte-lieu","Lieu d'une carte"],[".carte-appareil","Téléphone d'une carte"],[".badge","Badge de capture"],[".bouton-verre","Bouton"]],"calques":{"images":["photo","reel-video"],"composants":["onglets","onglet","carte","pastille","badge","rond-verre","bouton-verre","fiche","createur","commentaire","idee","avatar","bouton-reel","barre-etat","pile-carte","pile-lieu","champ-bloc","puce","sujet","question","article","interet","reglage-ligne","notif","feuille-ligne","option-creer","outil","segment","piste","lu","modele","envoi"],"noms":{"app":"Écran","barre-etat":"Barre d'état","etat-icones":"Icônes d'état","onglets":"Barre d'onglets","onglet":"O