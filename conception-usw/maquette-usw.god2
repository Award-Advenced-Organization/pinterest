>\r\n      <div class=\"dossier-texte\"><strong>Côte de Sèmè au matin</strong><span>@koffi.photo · photo</span><span class=\"raison forte\"><svg class=\"ic mini\"><use href=\"#i-etincelle\"/></svg>Signes d'IA · 72 %</span></div>\r\n      <span class=\"quand\">12 min</span>\r\n    </div>\r\n    <div class=\"dossier\" style=\"--n:1\">\r\n      <span class=\"photo ph-p15\"></span>\r\n      <div class=\"dossier-texte\"><strong>Cascade de Kota</strong><span>@senan.voyage · reel</span><span class=\"raison forte\"><svg class=\"ic mini\"><use href=\"#i-drapeau\"/></svg>Signalé 3 fois · pas pris à cet endroit</span></div>\r\n      <span class=\"quand\">40 min</span>\r\n    </div>\r\n    <div class=\"dossier\" style=\"--n:2\">\r\n      <span class=\"photo ph-p62\"></span>\r\n      <div class=\"dossier-texte\"><strong>Collines de Dassa</strong><span>@aminata.d · photo</span><span class=\"raison \"><svg class=\"ic mini\"><use href=\"#i-telephone\"/></svg>Téléphone déclaré, pas lu dans le fichier</span></div>\r\n      <span class=\"quand\">1 h</span>\r\n    </div>\r\n    <div class=\"dossier\" style=\"--n:3\">\r\n      <span class=\"photo ph-p46\"></span>\r\n      <div class=\"dossier-texte\"><strong>Marché Dantokpa</strong><span>@yao.b · photo</span><span class=\"raison \"><svg class=\"ic mini\"><use href=\"#i-profil\"/></svg>Visages en gros plan</span></div>\r\n      <span class=\"quand\">2 h</span>\r\n    </div>\r\n    <div class=\"dossier\" style=\"--n:4\">\r\n      <span class=\"photo ph-p116\"></span>\r\n      <div class=\"dossier-texte\"><strong>Ganvié au lever</strong><span>@lagune.229 · reel</span><span class=\"raison \"><svg class=\"ic mini\"><use href=\"#i-etincelle\"/></svg>Signes d'IA · 41 %</span></div>\r\n      <span class=\"quand\">3 h</span>\r\n    </div>\r\n  </div>\r\n  <nav class=\"onglets verre\" aria-label=\"Navigation principale\"><button type=\"button\" class=\"onglet\" aria-label=\"Accueil\"><svg class=\"ic\"><use href=\"#i-accueil\"/></svg></button><but