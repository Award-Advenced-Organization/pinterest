><button type=\"button\" class=\"rond-verre verre verre-appuyable petit-rond\" aria-label=\"Fermer\"><svg class=\"ic\"><use href=\"#i-fermer\"/></svg></button></div>\r\n    <div class=\"avis-liste\">\r\n      <div class=\"avis\">\r\n        <span class=\"avatar petit\" style=\"--teinte:hsl(160 55% 34%)\">SV</span>\r\n        <div class=\"avis-corps\">\r\n          <span class=\"epingle\"><svg class=\"ic mini\"><use href=\"#i-drapeau\"/></svg>Épinglé par l'auteur</span><p><b>Sènan Voyage</b><span class=\"marque-auteur\">Auteur</span> Le sentier part derrière le campement, 20 min de marche. Prenez des sandales qui tiennent.</p>\r\n          <div class=\"avis-pied\"><span>1 j</span><button type=\"button\">Répondre</button></div>\r\n        </div>\r\n        <button type=\"button\" class=\"avis-aime\" aria-label=\"J'aime\"><svg class=\"ic\"><use href=\"#i-coeur\"/></svg><span>412</span></button>\r\n      </div>\r\n      <div class=\"avis\">\r\n        <span class=\"avatar petit\" style=\"--teinte:hsl(18 70% 52%)\">AK</span>\r\n        <div class=\"avis-corps\">\r\n          <p><b>Akouavi K.</b> Le passage à <a class=\"moment\">0:12</a> 😍 On y va en janvier avec <a class=\"mention\">@mawuli.s</a>.</p>\r\n          <div class=\"avis-pied\"><span>6 h</span><button type=\"button\">Répondre</button></div>\r\n          <div class=\"reponses\">\r\n      <div class=\"avis\">\r\n        <span class=\"avatar petit\" style=\"--teinte:hsl(160 55% 34%)\">SV</span>\r\n        <div class=\"avis-corps\">\r\n          <p><b>Sènan Voyage</b> En janvier il reste de l'eau, mais moins de débit. Partez tôt !</p>\r\n          <div class=\"avis-pied\"><span>5 h</span><button type=\"button\">Répondre</button></div>\r\n        </div>\r\n        <button type=\"button\" class=\"avis-aime\" aria-label=\"J'aime\"><svg class=\"ic\"><use href=\"#i-coeur\"/></svg><span>18</span></button>\r\n      </div>\r\n          </div>\r\n        </div>\r\n        <button type=\"button\" class=\"avis-aime aime\" aria-label=\"J'aime\"><svg class=\"ic\"><use href=\"#i-coeur\"/></svg><span>57</span></button>\r\n      </div>\r\n      <div class=\"avis\">\r\n        <span class=\"avatar petit\" style=\"--teinte:hsl(200 60% 40%)\">YB</span>\r\n        <div class=\"avis-corps\">\r\n          <p><b>Yao B.</b> On peut s'y baigner ?</p>\r\n          <div class=\"avis-pied\"><span>3 h</span><button type=\"button\">Répondre</button></div>\r\n        </div>\r\n        <button type=\"button\" class=\"avis-aime\" aria-label=\"J'aime\"><svg class=\"ic\"><use href=\"#i-coeur\"/></svg><span>6</span></button>\r\n      </div>\r\n    </div>\r\n    <div class=\"saisie-bloc\">\r\n      <div class=\"saisie\"><span class=\"avatar petit\" style=\"--teinte:hsl(200 60% 40%)\">JD</span><div class=\"champ verre\"><span class=\"champ-place\">Ajouter un commentaire, @mentionner…</span></div>\r\n        <button type=\"button\" class=\"rond-verre verre verre-appuyable envoyer\" aria-label=\"Envoyer\"><svg class=\"ic\"><use href=\"#i-envoyer\"/></svg></button></div>\r\n    </div>\r\n  </div>\r\n</div>"},{"id":"reel-partager","nom":"E10 Partager le reel","adresse":"usw.app/reel-partager","fenetre":true,"liens":[{"selecteur":".appli","vers":"reel-telecharger","texte":"Télécharger"},{"selecteur":".appli","vers":"reel-enregistrer","texte":"Enregistrer"},{"selecteur":".appli","vers":"signaler","texte":"Signaler"},{"selecteur":".appli, .membre","vers":"retour"},{"selecteur":".onglet[aria-label=\"Accueil\"]","vers":"accueil"},{"selecteur":".onglet[aria-label=\"Reels\"]","vers":"reels"},{"selecteur":".onglet[aria-label=\"Créer\"]","vers":"creer"},{"selecteur":".onglet[aria-label=\"Carte\"]","vers":"carte"},{"selecteur":".onglet[aria-label=\"Profil\"]","vers":"profil"},{"selecteur":"[aria-label=\"Retour\"]","vers":"retour"},{"selecteur":"[aria-label=\"Fermer\"]","vers":"retour"},{"selecteur":".feuille-fond","vers":"retour"}],"balisage":"<div class=\"app fixe sombre reels\">\r\n  <div class=\"reel-video ph-p15\" role=\"