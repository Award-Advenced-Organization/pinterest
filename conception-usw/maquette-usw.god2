ction class=\"groupe\" style=\"--n:5\">\r\n    <h2 class=\"groupe-titre\">Équipe</h2>\r\n    <div class=\"groupe-corps verre-plaque\"><div class=\"reglage-ligne\"><span class=\"reglage-icone\"><svg class=\"ic\"><use href=\"#i-bouclier\"/></svg></span><span class=\"reglage-texte\">Modération</span><span class=\"reglage-valeur\">12</span><svg class=\"ic petite\"><use href=\"#i-chevron-droite\"/></svg></div></div>\r\n  </section>\r\n  <section class=\"groupe\" style=\"--n:6\">\r\n    <div class=\"groupe-corps verre-plaque\"><div class=\"reglage-ligne danger\"><span class=\"reglage-icone\"><svg class=\"ic\"><use href=\"#i-sortie\"/></svg></span><span class=\"reglage-texte\">Se déconnecter</span></div></div>\r\n  </section>\r\n  <button type=\"button\" class=\"supprimer\">Supprimer mon compte</button>\r\n  <p class=\"version\">USW 1.0 · Groupe 4, IFRI</p>\r\n  <div class=\"feuille-fond\"></div>\r\n  <div class=\"dialogue verre-plaque\" role=\"alertdialog\" aria-labelledby=\"dialogue-titre\">\r\n    <span class=\"dialogue-icone\"><svg class=\"ic\"><use href=\"#i-sortie\"/></svg></span>\r\n    <h2 id=\"dialogue-titre\">Se déconnecter ?</h2>\r\n    <p>Vos envois en cours seront mis en pause et reprendront à la prochaine connexion.</p>\r\n    <div class=\"dialogue-actions\">\r\n      <button type=\"button\" class=\"bouton-verre verre verre-appuyable\"><span class=\"bouton-verre-texte\">Annuler</span></button>\r\n      <button type=\"button\" class=\"bouton-verre verre verre-appuyable rouge\"><span class=\"bouton-verre-texte\">Se déconnecter</span></button>\r\n    </div>\r\n  </div>\r\n</div>"},{"id":"bulles","nom":"E37 Bulle d'aide et message","adresse":"usw.app/bulles","fenetre":true,"liens":[{"selecteur":".message-action","vers":"enregistrer"},{"selecteur":".bulle-aide","vers":"retour"},{"selecteur":"[aria-label=\"Commentaires\"]","vers":"commentaires"},{"selecteur":".commentaires","vers":"commentaires"},{"selecteur":"[aria-label=\"Partager\"]","vers":"partager"},{"selecteur":"[aria-label=\"Télécharger l'original\"]","vers":"telecharger"},{"selecteur":"[aria-label=\"Enregistrer\"]","vers":"enregistrer"},{"selecteur":".photo-grande .badge","vers":"bulles"},{"selecteur":".createur-nom, .createur .avatar","vers":"createur"},{"selecteur":".mosaique .carte","vers":"lieu"},{"selecteur":".onglet[aria-label=\"Accueil\"]","vers":"accueil"},{"selecteur":".onglet[aria-label=\"Reels\"]","vers":"reels"},{"selecteur":".onglet[aria-label=\"Créer\"]","vers":"creer"},{"selecteur":".onglet[aria-label=\"Carte\"]","vers":"carte"},{"selecteur":".onglet[aria-label=\"Profil\"]","vers":"profil"},{"selecteur":"[aria-label=\"Retour\"]","vers":"retour"},{"selecteur":"[aria-label=\"Fermer\"]","vers":"retour"},{"selecteur":".feuille-fond","vers":"retour"}],"balisage":"<div class=\"app photo-page\">\r\n  <div class=\"barre-etat\"><span>9:41</span><span class=\"etat-icones\"><svg class=\"ic\"><use href=\"#i-signal\"/></svg><svg class=\"ic\"><use href=\"#i-wifi\"/></svg><svg class=\"ic\"><use href=\"#i-batterie\"/></svg></span></div>\r\n  <div class=\"colonnes\">\r\n    <div class=\"photo-grande\">\r\n      <span class=\"photo ph-p108\"></span>\r\n      <div class=\"commandes\">\r\n        <button type=\"button\" class=\"rond-verre givre verre verre-appuyable\" aria-label=\"Retour\"><svg class=\"ic\"><use href=\"#i-retour\"/></svg></button>\r\n        <button type=\"button\" class=\"rond-verre givre verre verre-appuyable\" aria-label=\"Plus d'options\"><svg class=\"ic\"><use href=\"#i-plus-points\"/></svg></button>\r\n      </div>\r\n    </div>\r\n    <div class=\"colonne-infos\">\r\n      <div class=\"actions-photo\">\r\n        <button type=\"button\" class=\"action aime\" aria-label=\"Je n'aime plus\"><svg class=\"ic\"><use href=\"#i-coeur\"/></svg><span class=\"compte\">2,1 k</span></button>\r\n        <button type=\"button\" class=\"action\" aria-label=\"Commentaires\"><svg class=\"ic\"><use href=\"#i-commentaire\"/></svg><span class=\"compte\">48</span></button>\r\n        <button type=\"button\" class=\"action\" aria-label=\"Partager\"><svg class=\"ic\"><use href=\"#i-partager\"/></svg></button>\r\n        <button type=\"button\" class=\"action\" aria-label=\"Télécharger l'original\"><svg class=\"ic\"><use href=\"#i-telecharger\"/></svg></button>\r\n        <span class=\"espace\"></span>\r\n        <button type=\"button\" class=\"rond-verre verre verre-appuyable\" aria-label=\"Enregistrer\"><svg class=\"ic\"><use href=\"#i-enregistrer\"/></svg></button>\r\n        <button type=\"button\" class=\"bouton-verre verre verre-appuyable plein\"><span class=\"bouton-verre-texte\"><svg class=\"ic\"><use href=\"#i-y-aller\"/></svg>Y aller</span></button>\r\n      </div>\r\n      <div class=\"photo-texte\">\r\n        <h1 class=\"photo-titre mots\"><span class=\"m\"><span style=\"--k:0\">Les</span></span> <span class=\"m\"><span style=\"--k:1\">cocotiers</span></span> <span class=\"m\"><span style=\"--k:2\">de</span></span> <span class=\"m\"><span style=\"--k:3\">Grand-Popo</span></span></h1>\r\n        <p class=\"photo-legende\">Fin d'après-midi sur la Route des pêches, juste avant la marée haute. Le chemin de sable part derrière le dernier cocotier.</p>\r\n      </div>\r\n      <section class=\"fiche verre-plaque\" aria-label=\"Informations de capture\">\r\n        <div class=\"fiche-tete\"><h3>Informations de capture</h3><span class=\"badge verifie\"><svg class=\"ic\"><use href=\"#i-verifie\"/></svg>Vérifiée</span></div>\r\n        <dl>\r\n          <div class=\"fiche-ligne\"><svg class=\"ic\"><use href=\"#i-lieu\"/></svg><div><dt>Lieu</dt><dd>Plage de Grand-Popo, Mono, Bénin<span class=\"origine\">GPS de la prise de vue · 6,2795° N, 1,8226° E</span></dd></div></div>\r\n          <div class=\"fiche-ligne\"><svg class=\"ic\"><use href=\"#i-telephone\"/></svg><div><dt>Téléphone</dt><dd>iPhone 14 Pro<span class=\"origine\">Métadonnées du fichier</span></dd></div></div>\r\n          <div class=\"fiche-ligne\"><svg class=\"ic\"><use href=\"#i-calendrier\"/></svg><div><dt>Prise le</dt><dd>14 mars 2026, 17 h 52<span class=\"origine\">Métadonnées du fichier</span></dd></div></div>\r\n        </dl>\r\n      </section>\r\n      <div class=\"createur\">\r\n        <span class=\"avatar\" style=\"--teinte:hsl(18 70% 52%)\">AK</span>\r\n        <div><div class=\"createur-nom\">Akouavi K.</div><div class=\"createur-sous\">1 284 abonnés</div></div>\r\n        <button type=\"button\" class=\"bouton-verre verre verre-appuyable\"><span class=\"bouton-verre-texte\">S'abonner</span></button>\r\n      </div>\r\n      <section class=\"commentaires\">\r\n        <h3>48 commentaires</h3>\r\n        <div class=\"commentaire\"><span class=\"avatar petit\" style=\"--teinte:hsl(18 70% 52%)\">AK</span><div><span class=\"epingle\">Épinglé par l'auteur</span><b>Akouavi K.</b> Le chemin se prend à pied depuis le parking de l'hôtel, comptez dix minutes.</div></div>\r\n        <div class=\"commentaire\"><span class=\"avatar petit\" style=\"--teinte:hsl(160 45% 38%)\">MS</span><div><b>Mawuli S.</b> On y était dimanche avec <b style=\"color:var(--ocean)\">@senan.voyage</b>, c'est exactement ça.</div></div>\r\n        <div class=\"saisie-commentaire verre\">Ajouter un commentaire, @mentionner…</div>\r\n      </section>\r\n    </div>\r\n  </div>\r\n  <h2 class=\"suite-titre\">Plus de lieux comme celui-ci</h2>\r\n  <main class=\"mosaique\">\r\n      <article class=\"carte\" style=\"--n:0\">\r\n        <div class=\"carte-image\"><span class=\"photo ph-p77\"></span></div>\r\n        <div class=\"carte-pied\">\r\n          <div><div class=\"carte-lieu\">Ponton de Ouidah</div><div class=\"carte-appareil\"><svg class=\"ic mini\"><use href=\"#i-telephone\"/></svg>itel S23</div></div>\r\n        </div>\r\n      </article>\r\n      <article class=\"carte\" style=\"--n:1\">\r\n        <div class=\"carte-image\"><span class=\"photo ph-p62\"></span><span class=\"badge verifie\"><svg class=\"ic\"><use href=\"#i-verifie\"/></svg>Vérifiée</span></div>\r\n        <div class=\"carte-pied\">\r\n          <div><div class=\"carte-lieu\">Collines de Dassa-Zoumè</div><div class=\"carte-appareil\"><svg class=\"ic mini\"><use href=\"#i-telephone\"/></svg>Tecno Spark 20</div></div>\r\n        </div>\r\n      </article>\r\n      <article class=\"carte\" style=\"--n:2\">\r\n        <div class=\"carte-image\"><span class=\"photo ph-p92\"></span><span class=\"duree\">0:17</span><span class=\"son\"><svg class=\"ic\"><use href=\"#i-muet\"/></svg></span><span class=\"badge verifie\"><svg class=\"ic\"><use href=\"#i-verifie\"/></svg>Vérifiée</span></div>\r\n        <div class=\"carte-pied\">\r\n          <div><div class=\"carte-lieu\">Plage de Fidjrossè</div><div class=\"carte-appareil\"><svg class=\"ic mini\"><use href=\"#i-telephone\"/></svg>Samsung Galaxy A15</div></div>\r\n        </div>\r\n      </article>\r\n      <article class=\"carte\" style=\"--n:3\">\r\n        <div class=\"carte-image\"><span class=\"photo ph-p58\"></span></div>\r\n        <div class=\"carte-pied\">\r\n          <div><div class=\"carte-lieu\">Phare de Cotonou</div><div class=\"carte-appareil\"><svg class=\"ic mini\"><use href=\"#i-telephone\"/></svg>iPhone 12</div></div>\r\n        </div>\r\n      </article>\r\n  </main>\r\n  <nav class=\"onglets verre\" aria-label=\"Navigation principale\"><button type=\"button\" class=\"onglet\" aria-current=\"page\" aria-label=\"Accueil\"><svg class=\"ic\"><use href=\"#i-accueil\"/></svg></button><button type=\"button\" class=\"onglet\" aria-label=\"Reels\"><svg class=\"ic\"><use href=\"#i-reels\"/></svg></button><button type=\"button\" class=\"onglet creer verre verre-appuyable plein\" aria-label=\"Créer\"><svg class=\"ic\"><use href=\"#i-plus\"/></svg></button><button type=\"button\" class=\"onglet\" aria-label=\"Carte\"><svg class=\"ic\"><use href=\"#i-carte\"/></svg></button><button type=\"button\" class=\"onglet\" aria-label=\"Profil\"><svg class=\"ic\"><use href=\"#i-profil\"/></svg></button></nav>